---
/**
 * Base layout — semantic HTML, accessible, mobile-first.
 *
 * Structure mirrors the original WordPress/Elementor site:
 * - Header: sticky white bar with logo + hamburger menu icon
 * - Menu dialog: fullscreen slide-in navigation from right
 * - <slot/> for page content
 * - Footer: "Confían en nosotros" logos, 4-col grid, Kit Digital banner
 */
import { getMenu, getSiteSettings, getEmDashCollection } from "emdash";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { getUiLabels } from "../utils/ui-labels";
import { routeAlternatePath } from "../utils/alternate";
import type { SiteSettings } from "../types";

import SiteHeader from "../components/SiteHeader.astro";
import MenuDialog from "../components/MenuDialog.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/theme.css";

interface Props {
	title?: string;
	pageTitle?: string;
	description?: string;
	robots?: string;
	image?: string;
	canonical?: string;
	type?: string;
	publishedTime?: string | null;
	modifiedTime?: string | null;
	content?: { collection: string; id: string; slug: string };
	/**
	 * Alternate-locale path for hreflang + LanguageSwitcher (#291).
	 * Pages rendering a CMS entry MUST pass utils/alternate's
	 * entryAlternatePath() result — slugs are translated, so the prefix-swap
	 * default is only correct for locale-invariant routes. `null` = no
	 * published counterpart: no hreflang set, switcher falls back to the
	 * alternate homepage.
	 */
	altPath?: string | null;
}

const {
	title,
	pageTitle: ogTitleOverride,
	description,
	robots,
	image,
	canonical,
	type: ogType,
	publishedTime,
	modifiedTime,
	content: editableContent,
	altPath: altPathProp,
} = Astro.props;
const locale = Astro.currentLocale || "es";
const t = Astro.locals.t;

// Note: services and partners are also queried in HomepageContent.astro and
// CloudflarePartner.astro. This duplication is intentional — Astro does not
// support passing data through <slot/> to child components. EmDash caches
// query results at the request level, so the database is hit only once per
// collection per request. The overhead is negligible.
const [settings, siteMenu, servicesResult, partnersResult, labels] = await Promise.all([
	getSiteSettings(),
	getMenu(`site_${Astro.currentLocale || "es"}`),
	getEmDashCollection("services", {
		orderBy: { created_at: "asc" },
		locale,
	}),
	getEmDashCollection("partners", {
		orderBy: { created_at: "asc" },
	}),
	getUiLabels(locale),
]);

// NOTE: no Astro.cache.set here. Layout frontmatter runs mid-stream, after
// the response headers left — hints set here never reach the edge (measured,
// #357 E2E). The footer-data tags are added centrally in src/middleware.ts,
// which runs before the headers are finalized.

const { entries: serviceEntries } = servicesResult;
const { entries: partnerEntries } = partnersResult;
const services = serviceEntries ?? [];

const identity = resolveBlogSiteIdentity(settings);

// Wayfinding (#211): the header prompt shows the real pathname, and the
// section accent comes from the CMS service entry — ink everywhere else.
const promptPath = Astro.url.pathname.replace(/\/$/, "");
const currentSlug = promptPath.replace(/^\/en/, "").replace(/^\//, "");
const activeService = services.find((s: any) => (s.slug ?? s.id) === currentSlug);
const headerAccent = activeService?.data?.color || "#1E1E1E";

// Contact info from site settings
const s = settings as SiteSettings;
const phone = s.phone || "";
const phoneDisplay = s.phoneDisplay || "";
// The address is locale-specific: `hello@` answers in English, `hola@` in
// Spanish. The footer picked the Spanish one on every locale, so an English
// visitor got one address in the footer and another on the contact page (#311).
const email = (locale === "en" ? s.emailEn : s.email) || s.email || "hola@serverstartup.io";
// #311: templates render the ENCODED value; the plain one never reaches HTML.
// btoa, not Buffer: this renders on Workers. Computed rather than stored, so
// editing the address in the CMS cannot leave a stale encoded copy behind.
const emailEncoded = btoa(email);
const phoneEncoded = s.phoneEncoded || "";
const emailLabel = labels.get("footer_headings", "email_label",
	locale === "en" ? "Email us" : "Escríbenos");
// #306: this used to read site settings, which are locale-NEUTRAL by design
// (phone, email, company name). A CTA label is translatable copy, so every
// English page shipped the Spanish button while the band above it was in
// English. It lives with the other UI strings now.
const defaultCtaLabel = labels.get("footer_headings", "default_cta",
	s.defaultCtaLabel || (locale === "en" ? "Tell us about your project" : "Cuéntanos tu proyecto"));

// Footer headings from CMS (ui_labels widget area)
// #336: the feed link was hardcoded to the Spanish /rss.xml on all 14 EN
// pages, with an untranslated title. Both now come from the locale.
const rssPath = locale === "en" ? "/en/rss.xml" : "/rss.xml";
const rssTitle = labels.get("footer_headings", "rss_title",
	locale === "en" ? "Journal — RSS" : "Bitácora — RSS");
const trustTitle = labels.get("footer_headings", "trust_title", "Confían en nosotros");
const servicesTitle = labels.get("footer_headings", "services_title", "Áreas de especialización");
const partnersTitle = labels.get("footer_headings", "partners_title", "Somos partners");
const legalNoticeLabel = labels.get("footer_headings", "legal_notice", "Aviso legal");
const privacyLabel = labels.get("footer_headings", "privacy_policy", "Política de privacidad");
const contactTitle = labels.get("footer_headings", "contact_title", "Contacto");
const aboutUsLabel = labels.get("footer_headings", "about_us", "Quiénes somos");
const manualLabel = labels.get("manual_labels", "manual_footer_link", locale === "en" ? "Deconstructing this website" : "Deconstruyendo esta web");
const pageTitle = title
	? `${title} — ${identity.siteTitle}`
	: identity.siteTitle;
const pageDescription = description || identity.siteTagline;

// Menu items — classify by matching against services collection slugs
const siteMenuItems = siteMenu?.items ?? [];

// Locale-aware URL prefix ("" for ES default, "/en" for English)
const localePrefix = locale === "es" ? "" : `/${locale}`;

// Trust logos from partners collection (featured = true)
// Partner logos for the footer column. Deduplicated by image: the CMS
// carried five identical Cloudflare rows and every one of them rendered
// (#296). References live in their own collection and their own banner.
const partnerLogos = [
	...new Map(
		(partnerEntries ?? [])
			.filter((p) => Boolean(p.data.featured))
			.map((p) => [
				p.data.featured_image?.src || "",
				{
					src: p.data.featured_image?.src || "",
					alt: p.data.featured_image?.alt || p.data.title || "Partner",
				},
			]),
	).values(),
].filter((l) => l.src);

// Alternate locale URL for hreflang (absolute URLs per Google spec).
// The prop wins; the prefix-swap default is only correct for routes whose
// path is identical in both locales (#291).
const currentPath = Astro.url.pathname;
const altLocale = locale === "es" ? "en" : "es";
const altPath =
	altPathProp !== undefined ? altPathProp : routeAlternatePath(currentPath, locale);
const siteOrigin = Astro.site?.origin || "https://www.serverstartup.io";
const canonicalUrl = canonical || `${siteOrigin}${currentPath}`;
const altUrl = altPath ? `${siteOrigin}${altPath}` : null;
const defaultUrl = locale === "es" ? canonicalUrl : altUrl;
const ogImage = image || `${siteOrigin}/assets/logo-vertical.png`;
const resolvedOgTitle = ogTitleOverride || pageTitle;
const resolvedOgType = ogType || "website";
---

<html lang={Astro.currentLocale || "es"}>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{pageTitle}</title>
	<meta name="description" content={pageDescription} />
	{robots && <meta name="robots" content={robots} />}
	<link rel="canonical" href={canonicalUrl} />
	{altUrl && (
		<>
			<link rel="alternate" hreflang={locale} href={canonicalUrl} />
			<link rel="alternate" hreflang={altLocale} href={altUrl} />
			<link rel="alternate" hreflang="x-default" href={defaultUrl} />
		</>
	)}
	<meta property="og:title" content={resolvedOgTitle} />
	<meta property="og:description" content={pageDescription} />
	<meta property="og:url" content={canonicalUrl} />
	<meta property="og:type" content={resolvedOgType} />
	{publishedTime && <meta property="article:published_time" content={publishedTime} />}
	{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
	<meta property="og:image" content={ogImage} />
	<meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
	<meta property="og:site_name" content={identity.siteTitle} />
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={pageTitle} />
	<meta name="twitter:description" content={pageDescription} />
	<meta name="twitter:image" content={ogImage} />
	<link rel="icon" href="/assets/favicon.png" sizes="32x32" />
	<link rel="apple-touch-icon" href="/assets/icon-192.png" />
	<link rel="manifest" href="/site.webmanifest" />
	<meta name="theme-color" content="#1E1E1E" />
	<link rel="alternate" type="application/rss+xml" title={rssTitle} href={rssPath} />
</head>
<body>

	<!-- WCAG 2.4.1: the first Tab stop skips the header instead of walking it
	     on every page. Off-screen until focused, and it must clear the fixed
	     header when it appears — hence the offset, not just `top: 0`. -->
	<a href="#content" class="skip-link">{Astro.locals.t("skip_to_content")}</a>

	<SiteHeader promptPath={promptPath} accent={headerAccent} altPath={altPath} />

	<MenuDialog services={services} siteItems={siteMenuItems} currentPath={promptPath} localePrefix={localePrefix} />

	<!-- ═══ MAIN CONTENT ═══ -->
	<main id="content">
		<slot />
	</main>

	<SiteFooter
		trustTitle={trustTitle}
		servicesTitle={servicesTitle}
		partnersTitle={partnersTitle}
		legalNoticeLabel={legalNoticeLabel}
		privacyLabel={privacyLabel}
		contactTitle={contactTitle}
		aboutUsLabel={aboutUsLabel}
		manualLabel={manualLabel}
		defaultCtaLabel={defaultCtaLabel}
		emailEncoded={emailEncoded}
		phoneEncoded={phoneEncoded}
		emailLabel={emailLabel}
		email={email}
		phone={phone}
		phoneDisplay={phoneDisplay}
		partnerLogos={partnerLogos}
		services={services}
		localePrefix={localePrefix}
		locale={locale}
	/>

	<!-- ═══ SCRIPTS ═══ -->
	<script>
		// Menu dialog (non-native open/close for slide-in animation)
		const trigger = document.getElementById('menu-trigger');
		const dialog = document.getElementById('menu-dialog') as HTMLDialogElement;
		const backdrop = document.getElementById('menu-backdrop');
		const closeBtn = document.getElementById('menu-close');

		function openMenu() {
			dialog?.showModal();
			backdrop?.classList.add('is-open');
			dialog?.classList.add('is-open');
			trigger?.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
		}

		function closeMenu() {
			dialog?.classList.remove('is-open');
			backdrop?.classList.remove('is-open');
			trigger?.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
			// Wait for CSS transition before actually closing dialog
			setTimeout(() => dialog?.close(), 500);
		}

		trigger?.addEventListener('click', openMenu);
		closeBtn?.addEventListener('click', closeMenu);
		backdrop?.addEventListener('click', closeMenu);

		// Close on Escape
		dialog?.addEventListener('cancel', (e) => {
			e.preventDefault();
			closeMenu();
		});

		// Close on link click (navigate away)
		dialog?.querySelectorAll('.menu-link').forEach((link) => {
			link.addEventListener('click', closeMenu);
		});

		// Sticky header with shadow
		const header = document.getElementById('site-header');
		window.addEventListener('scroll', () => {
			header?.classList.toggle('is-sticky', window.scrollY > 50);
		}, { passive: true });
	</script>
</body>
</html>
