---
/**
 * Contact page (EN) — mirrors contacto.astro but queries locale="en".
 * Phone/WhatsApp are base64-encoded in settings and decoded on click, so the
 * number never appears in static HTML, JSON-LD or crawlable text.
 */
import { getEmDashEntry, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { contactJsonLd } from "../../utils/jsonld";
import type { SiteSettings } from "../../types";

const locale = "en";
let { entry, cacheHint } = await getEmDashEntry("pages", "contact", { locale });
if (!entry) ({ entry, cacheHint } = await getEmDashEntry("pages", "contacto", { locale }));
if (!entry) return Astro.redirect("/en/");
Astro.cache.set(cacheHint);

const { title, content, excerpt } = entry.data;
const settings = await getSiteSettings() as SiteSettings;

const email = settings.email || "ventas@serverstartup.io";
const phoneEncoded = settings.phoneEncoded || "";
const whatsappEncoded = settings.whatsappEncoded || "";

const whatsappLabel = settings.contactWhatsappLabel || "WhatsApp";
const phoneLabel = settings.contactPhoneLabel || "Phone";
const emailLabel = settings.contactEmailLabel || "Email";
---

<Base
	title={title}
	description={excerpt || `${title} — Server Startup`}
>
	<script type="application/ld+json" set:html={JSON.stringify(contactJsonLd({
		siteUrl: Astro.site?.origin!,
		description: excerpt || `${title} — Server Startup`,
		email,
	}))} />
	<section class="s-contact" aria-label={title}>
		<div class="container s-contact__inner">
			<h1>{title}</h1>
			{content && (
				<div class="s-contact__content">
					<PortableText value={content} />
				</div>
			)}

			<ul class="s-contact__methods" role="list">
				{whatsappEncoded && (
					<li><button type="button" class="s-contact__method" data-wa={whatsappEncoded} aria-label={whatsappLabel}>
						<span class="s-contact__method-label">{whatsappLabel}</span>
						<svg class="s-contact__arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</button></li>
				)}

				{phoneEncoded && (
					<li><button type="button" class="s-contact__method" data-tel={phoneEncoded} aria-label={phoneLabel}>
						<span class="s-contact__method-label">{phoneLabel}</span>
						<svg class="s-contact__arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</button></li>
				)}

				<li><a href={`mailto:${email}`} class="s-contact__method">
					<span class="s-contact__method-label">{emailLabel}</span>
					<svg class="s-contact__arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
					<span class="s-contact__method-value">{email}</span>
				</a></li>
			</ul>
		</div>
	</section>
</Base>

<script>
	for (const el of document.querySelectorAll<HTMLElement>("[data-tel],[data-wa]")) {
		el.addEventListener("click", () => {
			if (el.dataset.tel) location.href = "tel:" + atob(el.dataset.tel);
			else if (el.dataset.wa) window.open("https://wa.me/" + atob(el.dataset.wa), "_blank", "noopener");
		});
	}
</script>

<style>
	@import "../../styles/contact.css";
</style>
