---
/**
 * References (EN) — mirrors referencias.astro; the terminal output is
 * deliberately identical (a server's ls does not translate).
 */
import { getEmDashEntry, getEmDashCollection } from "emdash";
import { PortableText } from "emdash/ui";
import PtLink from "../../components/PtLink.astro";
import CubeEmblem from "../../components/CubeEmblem.astro";
import CtaGlobal from "../../components/CtaGlobal.astro";
import Base from "../../layouts/Base.astro";
import { entryAlternatePath } from "../../utils/alternate";
import { getUiLabels } from "../../utils/ui-labels";
import { SITE_BY_PATH } from "../../utils/nav";

const ptComponents = { mark: { link: PtLink } };
const locale = "en";

let { entry, cacheHint } = await getEmDashEntry("pages", "references", { locale });
if (!entry) ({ entry, cacheHint } = await getEmDashEntry("pages", "referencias", { locale }));
if (!entry) return Astro.rewrite("/404");
if (cacheHint) Astro.cache.set(cacheHint);

// Slugs are translated across locales — resolve the counterpart via the CMS (#291)
const altPath = entry ? await entryAlternatePath("pages", entry.data.id, locale) : null;

const { title, content, excerpt } = entry.data;
const labels = await getUiLabels(locale);

const refsResult = await getEmDashCollection("references", {
	orderBy: { created_at: "asc" },
});
if (refsResult.cacheHint) Astro.cache.set(refsResult.cacheHint);
const refs = refsResult.entries ?? [];

// `ls` sorts by name; our slugs are alphabetized into the names' order.
const rows = refs
	.filter((r: any) => Boolean(r.data.featured) && r.data.featured_image?.src)
	.sort((a: any, b: any) =>
		String((a as any).slug ?? a.id).localeCompare(String((b as any).slug ?? b.id)))
	.map((r: any) => {
		const [groupKey, size] = String(r.data.excerpt || "clientes · —").split(" · ");
		return {
			src: r.data.featured_image.src,
			alt: r.data.featured_image.alt ?? "",
			group: labels.get("refs_labels", `group_${groupKey}`, groupKey),
			// clients carry the execute bit — we run things for them;
			// collaborations stay read-only
			perms: groupKey === "clientes" ? "-r-xr-xr-x" : "-r--r--r--",
			size,
		};
	});

const latticeAria = labels.get("refs_labels", "lattice_aria", "References");
const disclaimer = labels.get("refs_labels", "disclaimer",
	"All logos belong to their respective owners; shown solely as a factual reference of delivered work.");


const emblemKey = SITE_BY_PATH[Astro.url.pathname.replace(/\/$/, "")];
const accentColor = "#1E1E1E";
---

<Base title={title} description={excerpt || `${title} — Server Startup`} altPath={altPath}>
	<div class="s-emblem-bg s-emblem-bg--refs" aria-hidden="true">
		<CubeEmblem color="var(--color-primary)" faceKey={emblemKey} size={340} />
	</div>

	<!-- ══════ HERO ══════ -->
	<section class="s-hero" aria-label={title}>
		<div class="container s-hero__inner">
			<div class="s-hero__copy">
				<h1>{title}</h1>
				{(content || []).length > 0 && (
					<div class="s-hero__body">
						<PortableText value={content as any[]} components={ptComponents} />
					</div>
				)}
			</div>
		</div>
	</section>

	<!-- ══════ THE LISTING — title above, terminal below, nothing else ══════ -->
	<section class="refs">
		<div class="container refs__inner">
			<figure class="ls" aria-label={latticeAria}>
				<div class="ls__chrome" aria-hidden="true"><i></i><i></i><i></i></div>
				<p class="ls__cmd" aria-hidden="true">ls -alh references/</p>
				<ul class="ls__out" role="list">
					<li class="ls-row ls-row--dim" aria-hidden="true">
						<span class="ls-pre">total 9</span>
					</li>
					<li class="ls-row ls-row--dim" aria-hidden="true">
						<span class="ls-perms">drwxr-xr-x</span><span class="ls-n">2</span><span class="ls-owner">serverstartup</span><span class="ls-group">{labels.get("refs_labels", "group_clientes", "clientes")}</span><span class="ls-size">96B</span><span class="ls-date">Jan 24 2019</span><span class="ls-name">.</span>
					</li>
					<li class="ls-row ls-row--dim" aria-hidden="true">
						<span class="ls-perms">drwxr-xr-x</span><span class="ls-n">5</span><span class="ls-owner">serverstartup</span><span class="ls-group">serverstartup</span><span class="ls-size">160B</span><span class="ls-date">Jan 24 2019</span><span class="ls-name">..</span>
					</li>
					{rows.map((r) => (
						<li class="ls-row">
							<span class="ls-perms" aria-hidden="true">{r.perms}</span><span class="ls-n" aria-hidden="true">1</span><span class="ls-owner" aria-hidden="true">serverstartup</span><span class="ls-group">{r.group}</span><span class="ls-size" aria-hidden="true">{r.size}</span><span class="ls-date" aria-hidden="true">Jan 24 2019</span><span class="ls-name"><img src={r.src} alt={r.alt} loading="lazy" decoding="async" /></span>
						</li>
					))}
				</ul>
			</figure>
			<p class="refs-disclaimer">{disclaimer}</p>

		</div>
	</section>

	<!-- ══════ CTA (from cta_global widget) ══════ -->
	<CtaGlobal />
</Base>

<style is:global define:vars={{ accentColor }}>
	@import "../../styles/service.css";
	@import "../../styles/refs.css";
</style>
