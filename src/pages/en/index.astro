---
/**
 * English homepage — /en
 * Thin wrapper around HomepageContent component.
 * All layout logic lives in HomepageContent.astro (DRY).
 */
import Base from "../../layouts/Base.astro";
import HomepageContent from "../../components/HomepageContent.astro";
import { getEmDashEntry, getSiteSettings } from "emdash";
import { homepageJsonLd } from "../../utils/jsonld";
import type { SiteSettings } from "../../types";

const locale = "en";
const { entry, cacheHint } = await getEmDashEntry("pages", "home", { locale });
// PAGE frontmatter on purpose — a child component's cache.set runs mid-stream,
// too late for headers (see index.astro / #357 E2E finding).
Astro.cache.set(cacheHint);
const { title, excerpt } = entry?.data ?? { title: "Server Startup", excerpt: "" };
const settings = await getSiteSettings() as SiteSettings;
const description = excerpt || `${title} — Server Startup`;
// The document title is the H1's head (before the colon): Base appends
// the site name and html-validate caps <title> at 70 chars — the full
// H1 overflows it. H1 and <title> differing is standard SEO practice.
const seoTitle = title.split(":")[0].trim();
const schemas = homepageJsonLd({
	siteUrl: Astro.site?.origin!,
	description,
	locale,
	phone: settings.phone,
	// #311: deliberately omitted — jsonld.ts already says why: an address in
	// JSON-LD is indexed, which defeats the click-to-decode obfuscation the
	// rest of the site relies on. contactJsonLd honoured that; this did not.
});
---

<Base
	title={seoTitle}
	description={description}
>
	{schemas.map((schema) => (
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	))}
	<HomepageContent />
</Base>

<style is:global>
	@import "../../styles/homepage.css";
</style>
