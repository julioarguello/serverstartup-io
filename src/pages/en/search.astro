---
/**
 * EN Search page — locale-aware wrapper.
 * Uses EmDash's FTS5-backed search() for efficient database-side filtering.
 */
export const prerender = false;

import { search } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getUiLabels } from "../../utils/ui-labels";

const query = Astro.url.searchParams.get("q")?.trim() || "";
const labels = await getUiLabels("en");

const searchTitle = labels.get("search_page", "search_title", "Search");
const searchLabel = labels.get("search_page", "search_label", "Search articles");
const searchPlaceholder = labels.get("search_page", "search_placeholder", "Search articles...");
const searchHint = labels.get("search_page", "search_hint", "Enter a term to search articles.");
const searchNoResults = labels.get("search_page", "search_no_results", "No results for");
const searchResults = labels.get("search_page", "search_results", "result(s) for");
const searchDescription = labels.get("search_page", "search_description", "Search Server Startup blog");

// Use EmDash's FTS5-backed search instead of loading all posts into memory.
const results = query
	? (await search(query, { collections: ["posts"], locale: "en", limit: 20 })).items
	: [];
---

<Base
	title={query ? `${searchTitle}: ${query}` : searchTitle}
	description={searchDescription}
>
	<section class="search-page" aria-label={searchTitle}>
		<div class="container search-inner">
			<h1>{searchTitle}</h1>

			<form method="get" action="/en/search" class="search-form" role="search">
				<label for="search-input" class="sr-only">{searchLabel}</label>
				<input
					type="search"
					id="search-input"
					name="q"
					value={query}
					placeholder={searchPlaceholder}
					class="search-input"
					autofocus
				/>
				<button type="submit" class="btn btn-dark">{searchTitle}</button>
			</form>

			{query && (
				<p class="search-summary">
					{results.length === 0
						? `${searchNoResults} "${query}"`
						: `${results.length} ${searchResults} "${query}"`}
				</p>
			)}

			{results.length > 0 && (
				<div class="search-results">
					{results.map((result) => (
						<PostCard
							title={result.title || ""}
							href={`/posts/${result.slug || result.id}`}
						/>
					))}
				</div>
			)}

			{!query && <p class="text-body search-hint">{searchHint}</p>}
		</div>
	</section>
</Base>

<style>
	@import "../../styles/search.css";
</style>
