---
/**
 * Contacto page — layout in template, content + contact data from CMS.
 * - Hero with h1 "Contacto"
 * - Content from CMS (intro text + bullet list)
 * - 3 contact methods (WhatsApp, Teléfono, Email) — data from site settings
 */
import { getEmDashEntry, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";

const locale = Astro.currentLocale || "es";
const { entry, cacheHint } = await getEmDashEntry("pages", "contacto", { locale });
if (!entry) return Astro.redirect("/404");
Astro.cache.set(cacheHint);

const { title, content, excerpt } = entry.data;
const settings = await getSiteSettings();

// Contact info from site settings (fallback to hardcoded for safety)
const phone = (settings as any).phone || "+34666666666";
const phoneDisplay = (settings as any).phoneDisplay || "666 66 66 66";
const email = (settings as any).email || "info@serverstartup.com";
const whatsapp = (settings as any).whatsapp || `https://wa.me/${phone.replace('+', '')}`;

// Contact method labels from site settings
const whatsappLabel = (settings as any).contactWhatsappLabel || "WhatsApp";
const phoneLabel = (settings as any).contactPhoneLabel || "Teléfono";
const emailLabel = (settings as any).contactEmailLabel || "Email";
---

<Base
	title={title}
	description={excerpt || `${title} — Server Startup`}
>
	<section class="s-contact" aria-label={title}>
		<div class="container s-contact__inner">
			<h1>{title}</h1>
			{content && (
				<div class="s-contact__content">
					<PortableText value={content} />
				</div>
			)}

			<div class="s-contact__methods" role="list">
				<a href={whatsapp} target="_blank" rel="noopener" class="s-contact__method" role="listitem" aria-label={`${whatsappLabel}`}>
					<span class="s-contact__method-label">{whatsappLabel}</span>
					<svg class="s-contact__arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
					<span class="s-contact__method-value">{phoneDisplay}</span>
				</a>

				<a href={`tel:${phone}`} class="s-contact__method" role="listitem" aria-label={`${phoneLabel}`}>
					<span class="s-contact__method-label">{phoneLabel}</span>
					<svg class="s-contact__arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
					<span class="s-contact__method-value">{phoneDisplay}</span>
				</a>

				<a href={`mailto:${email}`} class="s-contact__method" role="listitem" aria-label={`${emailLabel}`}>
					<span class="s-contact__method-label">{emailLabel}</span>
					<svg class="s-contact__arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
					<span class="s-contact__method-value">{email}</span>
				</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.s-contact {
		padding: calc(80px + 24px) 0 60px;
	}

	.s-contact__inner h1 {
		margin-bottom: var(--widget-spacing);
	}

	.s-contact__content {
		margin-bottom: 48px;
	}

	.s-contact__content :global(p) {
		font-size: 20px;
		font-weight: 300;
		line-height: 28px;
	}

	.s-contact__content :global(ul) {
		list-style: disc;
		padding-left: 24px;
		margin-top: 8px;
	}

	.s-contact__content :global(li) {
		font-family: var(--font-family);
		font-size: 20px;
		font-weight: 400;
		line-height: 28px;
	}

	/* ── Contact methods ── */
	.s-contact__methods {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.s-contact__method {
		display: flex;
		flex-direction: column;
		padding: 0;
		text-decoration: none;
		color: var(--color-primary);
		transition: color 0.2s;
	}

	.s-contact__method:hover {
		color: rgba(30, 30, 30, 0.7);
	}

	.s-contact__method-label {
		font-family: var(--font-family);
		font-size: 18px;
		font-weight: 400;
		line-height: 24px;
	}

	.s-contact__arrow {
		width: 24px;
		height: 24px;
		margin: 4px 0;
	}

	.s-contact__method-value {
		font-family: var(--font-family);
		font-size: 20px;
		font-weight: 300;
		line-height: 26px;
	}

	@media (min-width: 768px) {
		.s-contact {
			padding: 0;
			min-height: calc(100vh - 200px);
			display: flex;
			align-items: center;
		}

		.s-contact__methods {
			flex-direction: row;
			gap: 48px;
		}
	}
</style>
