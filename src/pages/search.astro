---
export const prerender = false;

import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getReadingTime, extractText } from "../utils/reading-time";
import { getUiLabels } from "../utils/ui-labels";

const query = Astro.url.searchParams.get("q")?.trim() || "";

const [{ entries: allPosts }, labels] = await Promise.all([
	getEmDashCollection("posts"),
	getUiLabels(Astro.currentLocale || "es"),
]);

// CMS-driven search labels
const searchTitle = labels.get("search_page", "search_title", "Buscar");
const searchLabel = labels.get("search_page", "search_label", "Buscar artículos");
const searchPlaceholder = labels.get("search_page", "search_placeholder", "Buscar artículos...");
const searchHint = labels.get("search_page", "search_hint", "Introduce un término para buscar artículos.");
const searchNoResults = labels.get("search_page", "search_no_results", "Sin resultados para");
const searchResults = labels.get("search_page", "search_results", "resultado(s) para");
const searchDescription = labels.get("search_page", "search_description", "Busca en el blog de Server Startup");

// Simple search: match query against title, excerpt, and content
function matchesQuery(post: (typeof allPosts)[0], q: string): boolean {
	if (!q) return false;
	const lower = q.toLowerCase();
	const title = (post.data.title || "").toLowerCase();
	const excerpt = (post.data.excerpt || "").toLowerCase();
	// Extract plain text from portable text blocks (avoids matching on _type, _key, etc.)
	const content = extractText(post.data.content).toLowerCase();
	return (
		title.includes(lower) || excerpt.includes(lower) || content.includes(lower)
	);
}

const results = query ? allPosts.filter((p) => matchesQuery(p, query)) : [];
---

<Base
	title={query ? `${searchTitle}: ${query}` : searchTitle}
	description={searchDescription}
>
	<section class="search-page" aria-label={searchTitle}>
		<div class="container search-inner">
			<h1>{searchTitle}</h1>

			<form method="get" action="/search" class="search-form" role="search">
				<label for="search-input" class="sr-only">{searchLabel}</label>
				<input
					type="search"
					id="search-input"
					name="q"
					value={query}
					placeholder={searchPlaceholder}
					class="search-input"
					autofocus
				/>
				<button type="submit" class="btn btn-dark">{searchTitle}</button>
			</form>

			{query && (
				<p class="search-summary">
					{results.length === 0
						? `${searchNoResults} "${query}"`
						: `${results.length} ${searchResults} "${query}"`}
				</p>
			)}

			{results.length > 0 && (
				<div class="search-results">
					{results.map((post) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
						/>
					))}
				</div>
			)}

			{!query && <p class="text-body search-hint">{searchHint}</p>}
		</div>
	</section>
</Base>

<style>
	.search-page {
		padding: calc(80px + 40px) 0 80px;
	}

	.search-inner h1 {
		margin-bottom: 24px;
	}

	.search-form {
		display: flex;
		gap: 8px;
		margin-bottom: 32px;
	}

	.search-input {
		flex: 1;
		padding: 12px 16px;
		font-family: var(--font-family);
		font-size: 18px;
		font-weight: 300;
		border: 1px solid var(--color-primary);
		border-radius: 0;
		background: var(--color-secondary);
		color: var(--color-text);
	}

	.search-input:focus {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	.search-summary {
		font-size: 18px;
		font-weight: 300;
		color: rgba(30, 30, 30, 0.6);
		margin-bottom: 24px;
	}

	.search-hint {
		color: rgba(30, 30, 30, 0.6);
	}

	.search-results {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	@media (min-width: 768px) {
		.search-page { padding: 160px 0 80px; }
	}
</style>
