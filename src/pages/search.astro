---
export const prerender = false;

import { search } from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getReadingTime } from "../utils/reading-time";
import { getUiLabels } from "../utils/ui-labels";

const query = Astro.url.searchParams.get("q")?.trim() || "";
const locale = Astro.currentLocale || "es";
const labels = await getUiLabels(locale);

// CMS-driven search labels
const searchTitle = labels.get("search_page", "search_title", "Buscar");
const searchLabel = labels.get("search_page", "search_label", "Buscar artículos");
const searchPlaceholder = labels.get("search_page", "search_placeholder", "Buscar artículos...");
const searchHint = labels.get("search_page", "search_hint", "Introduce un término para buscar artículos.");
const searchNoResults = labels.get("search_page", "search_no_results", "Sin resultados para");
const searchResults = labels.get("search_page", "search_results", "resultado(s) para");
const searchDescription = labels.get("search_page", "search_description", "Busca en el blog de Server Startup");

// Use EmDash's FTS5-backed search instead of loading all posts into memory.
// This delegates filtering to the database, avoiding O(n × m) substring scans.
const results = query
	? (await search(query, { collections: ["posts"], locale, limit: 20 })).items
	: [];
---

<Base
	title={query ? `${searchTitle}: ${query}` : searchTitle}
	description={searchDescription}
>
	<section class="search-page" aria-label={searchTitle}>
		<div class="container search-inner">
			<h1>{searchTitle}</h1>

			<form method="get" action={`${locale === "es" ? "" : `/${locale}`}/search`} class="search-form" role="search">
				<label for="search-input" class="sr-only">{searchLabel}</label>
				<input
					type="search"
					id="search-input"
					name="q"
					value={query}
					placeholder={searchPlaceholder}
					class="search-input"
					autofocus
				/>
				<button type="submit" class="btn btn-dark">{searchTitle}</button>
			</form>

			{query && (
				<p class="search-summary">
					{results.length === 0
						? `${searchNoResults} "${query}"`
						: `${results.length} ${searchResults} "${query}"`}
				</p>
			)}

			{results.length > 0 && (
				<div class="search-results">
					{results.map((result) => (
						<PostCard
							title={result.title || ""}
							href={`/posts/${result.slug || result.id}`}
						/>
					))}
				</div>
			)}

			{!query && <p class="text-body search-hint">{searchHint}</p>}
		</div>
	</section>
</Base>

<style>
	@import "../styles/search.css";
</style>
