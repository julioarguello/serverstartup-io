---
import { getEmDashCollection, getEntryTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import { getReadingTime } from "../../utils/reading-time";
const t = Astro.locals.t;

const { entries: posts, cacheHint } = await getEmDashCollection("posts");

Astro.cache.set(cacheHint);

const sortedPosts = posts.toSorted((a, b) => {
	const dateA = a.data.publishedAt?.getTime() ?? 0;
	const dateB = b.data.publishedAt?.getTime() ?? 0;
	return dateB - dateA;
});

// Fetch tags for each post (bylines are already hydrated by getEmDashCollection)
const postsWithTags = await Promise.all(
	sortedPosts.map(async (post) => {
		const tags = await getEntryTerms("posts", post.data.id, "tag");
		const bylines = post.data.bylines ?? [];
		return { post, tags, bylines };
	})
);

const dateLocale = (Astro.currentLocale || "es") === "en" ? "en-US" : "es-ES";
const formatDate = (date: Date) =>
	date.toLocaleDateString(dateLocale, {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
---

<Base title={t("articles_title")} description={t("articles_description")}>
	<div class="posts-page">
		<div class="container">
			<header class="page-header">
				<h1>{t("articles_title")}</h1>
				<p class="text-body page-count">
					{posts.length}
					{posts.length === 1 ? t("article_singular") : t("article_plural")}
				</p>
			</header>

			{
				sortedPosts.length === 0 ? (
					<p class="text-body empty">{t("no_articles")}</p>
				) : (
					<div class="posts-list">
						{postsWithTags.map(({ post, tags, bylines }) => (
							<article class="post-item">
								<a href={`/posts/${post.id}`} class="post-link">
									<div class="post-meta">
										{bylines.length > 0 && (
											<>
												<div class="post-bylines">
													{bylines.slice(0, 2).map((credit, index) => (
														<>
															{index > 0 && <span class="byline-sep">,</span>}
															<span class="post-byline">
																{credit.byline.avatarMediaId && (
																	<img
																		src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
																		alt={credit.byline.displayName}
																		class="post-byline-avatar"
																	/>
																)}
																<span class="post-byline-name">
																	{credit.byline.displayName}
																</span>
															</span>
														</>
													))}
													{bylines.length > 2 && (
														<span class="byline-more">+{bylines.length - 2}</span>
													)}
												</div>
												<span class="meta-dot" />
											</>
										)}
										{post.data.publishedAt && (
											<time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
										)}
										{post.data.publishedAt && <span class="meta-dot" />}
										<span>{getReadingTime(post.data.content)} {t("min_read")}</span>
									</div>
									<h2 class="post-title">{post.data.title}</h2>
									{post.data.excerpt && (
										<p class="post-excerpt">{post.data.excerpt}</p>
									)}
								</a>
								{tags.length > 0 && (
									<div class="post-tags">
										{tags.slice(0, 3).map((tag) => (
											<a href={`/tag/${tag.slug}`} class="post-tag">
												{tag.label}
											</a>
										))}
									</div>
								)}
							</article>
						))}
					</div>
				)
			}
		</div>
	</div>
</Base>

<style>
	.posts-page {
		padding: calc(80px + 40px) 0 80px;
	}

	.page-header {
		margin-bottom: 48px;
	}

	.page-count {
		color: rgba(30, 30, 30, 0.5);
	}

	.empty {
		color: rgba(30, 30, 30, 0.5);
	}

	.posts-list {
		display: flex;
		flex-direction: column;
	}

	.post-item {
		padding: 32px 0;
		border-bottom: 1px solid rgba(30, 30, 30, 0.1);
	}

	.post-item:first-child {
		padding-top: 0;
	}

	.post-item:last-child {
		border-bottom: none;
	}

	.post-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 14px;
		color: rgba(30, 30, 30, 0.5);
		margin-bottom: 8px;
	}

	.meta-dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: rgba(30, 30, 30, 0.5);
	}

	/* Post bylines */
	.post-bylines {
		display: flex;
		align-items: center;
		gap: 2px;
	}

	.post-byline {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}

	.post-byline-avatar {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		object-fit: cover;
	}

	.post-byline-name {
		font-weight: 500;
		color: rgba(30, 30, 30, 0.7);
	}

	.byline-sep {
		color: rgba(30, 30, 30, 0.5);
		margin-right: 2px;
	}

	.byline-more {
		font-size: 12px;
		color: rgba(30, 30, 30, 0.5);
		margin-left: 2px;
	}

	.post-title {
		font-size: 24px;
		font-weight: 600;
		line-height: 30px;
		letter-spacing: -0.01em;
		margin-bottom: 8px;
		transition: color 0.2s;
	}

	.post-link:hover .post-title {
		color: rgba(30, 30, 30, 0.7);
	}

	.post-excerpt {
		font-size: 18px;
		line-height: 24px;
		color: rgba(30, 30, 30, 0.7);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 16px;
	}

	.post-tag {
		display: inline-block;
		padding: 4px 12px;
		font-size: 14px;
		color: rgba(30, 30, 30, 0.7);
		background: #f5f5f5;
		border-radius: 4px;
		text-decoration: none;
		transition: color 0.2s, background 0.2s;
	}

	.post-tag:hover {
		color: var(--color-text);
		background: #e8e8e8;
	}

	@media (min-width: 768px) {
		.posts-page { padding: 160px 0 80px; }
		.post-title { font-size: 28px; line-height: 34px; }
	}
</style>
