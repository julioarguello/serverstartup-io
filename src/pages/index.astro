---
/**
 * Homepage — CMS-driven content, pixel-perfect layout.
 *
 * Content source: pages/home (EmDash CMS)
 * PT sections split by h2 headings:
 *   - hero: blocks before first h2
 *   - "~ Tecnología que impulsa tu negocio": h2 + body
 *   - "~ Áreas de especialización": h2 + subtitle
 *   - "~ CTA": h2 + heading + subtitle + body
 *
 * Sections 3 (Cloudflare) and 4 cards (services) remain template-driven
 * pending issues #4 and #6.
 */
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";

const { entry, cacheHint } = await getEmDashEntry("pages", "home");
if (!entry) return Astro.redirect("/404");
Astro.cache.set(cacheHint);

const { title, content, excerpt } = entry.data;

// Split PT content by h2 headings into named sections
type Section = { heading: string; blocks: any[] };
const sections: Section[] = [];
let currentSection: Section = { heading: "", blocks: [] };

for (const block of content || []) {
	if (block._type === "block" && block.style === "h2") {
		if (currentSection.heading || currentSection.blocks.length > 0) {
			sections.push(currentSection);
		}
		const headingText = block.children?.map((c: any) => c.text).join("") || "";
		currentSection = { heading: headingText, blocks: [] };
	} else {
		currentSection.blocks.push(block);
	}
}
if (currentSection.heading || currentSection.blocks.length > 0) {
	sections.push(currentSection);
}

// Named section extraction
const heroSection = sections[0]; // blocks before first h2
const techSection = sections.find((s) => s.heading.includes("Tecnología"));
const areasSection = sections.find((s) => s.heading.includes("Áreas"));
const ctaSection = sections.find((s) => s.heading.includes("CTA"));

// Extract CTA content: first block = heading, second = subtitle, third = body
const ctaHeading = ctaSection?.blocks[0]?.children?.map((c: any) => c.text).join("") || "¿Listo para optimizar tu infraestructura digital?";
const ctaSubtitle = ctaSection?.blocks[1]?.children?.map((c: any) => c.text).join("") || "";
const ctaBody = ctaSection?.blocks[2]?.children?.map((c: any) => c.text).join("") || "";

// Extract tech subtitle (first block with marks) and body (second block)
const techSubtitleBlock = techSection?.blocks[0];
const techBodyBlock = techSection?.blocks[1];

// Extract areas subtitle
const areasSubtitle = areasSection?.blocks[0]?.children?.map((c: any) => c.text).join("") || "";
---

<Base
	title={title}
	description={excerpt || `${title} — Server Startup`}
>
	<!-- ══════ SECTION 1: HERO ══════ -->
	<section class="s-hero" aria-label="Introducción">
		<div class="container s-hero__inner">
			<h1>{title}</h1>
			{heroSection?.blocks.length > 0 && (
				<div class="s-hero__kicker">
					<PortableText value={[heroSection.blocks[0]]} />
				</div>
			)}
			{heroSection?.blocks.length > 1 && (
				<div class="s-hero__body">
					<PortableText value={heroSection.blocks.slice(1)} />
				</div>
			)}
			<a href="#areas-especializacion" class="btn btn-dark">Nuestros servicios</a>
		</div>
	</section>

	<!-- ══════ SECTION 2: TECNOLOGÍA QUE IMPULSA TU NEGOCIO ══════ -->
	{techSection && (
		<section class="s-tech" aria-label={techSection.heading}>
			<div class="container s-tech__inner">
				<div class="s-tech__col-left">
					<h2>{techSection.heading}</h2>
				</div>
				<div class="s-tech__col-right">
					{techSubtitleBlock && (
						<div class="s-tech__subtitle-wrap">
							<PortableText value={[techSubtitleBlock]} />
						</div>
					)}
					{techBodyBlock && (
						<div class="s-tech__body-wrap">
							<PortableText value={[techBodyBlock]} />
						</div>
					)}
				</div>
			</div>
		</section>
	)}

	<!-- ══════ SECTION 3: CLOUDFLARE PARTNER (template-driven, issue #6) ══════ -->
	<section class="s-cf" aria-label="Cloudflare Partner">
		<div class="container s-cf__wrapper">
			<article class="s-cf__card">
				<img
					src="/assets/logo-cloudflare.svg"
					alt="Cloudflare"
					width="268"
					class="s-cf__logo"
					loading="lazy"
				/>
				<h3>Cloudflare Partner oficial</h3>
				<p class="text-body s-cf__desc">Aceleramos y protegemos tu infraestructura con las soluciones más avanzadas de Cloudflare</p>

				<div class="s-cf__features" role="list">
					<div class="s-cf__feature" role="listitem">
						<h4>CDN global</h4>
						<p class="text-body">para mejorar la velocidad de carga</p>
					</div>
					<div class="s-cf__feature" role="listitem">
						<h4>WAF y Zero Trust</h4>
						<p class="text-body">para reforzar la seguridad</p>
					</div>
					<div class="s-cf__feature" role="listitem">
						<h4>Workers y Edge Computing</h4>
						<p class="text-body">para arquitecturas modernas y flexibles</p>
					</div>
				</div>

				<a href="/cdn-waf-seguridad-edge-cloudflare" class="btn btn-dark">Descubre más sobre Cloudflare</a>
			</article>
		</div>
	</section>

	<!-- ══════ SECTION 4: ÁREAS DE ESPECIALIZACIÓN (cards template-driven, issue #4) ══════ -->
	<section class="s-areas" id="areas-especializacion" aria-label={areasSection?.heading || "Áreas de especialización"}>
		<div class="container s-areas__inner">
			<!-- Left: sticky header -->
			<div class="s-areas__header">
				<h2>{areasSection?.heading || "~ Áreas de especialización"}</h2>
				<p class="text-sub">{areasSubtitle}</p>
			</div>

			<!-- Right: stacking cards (template-driven, issue #4) -->
			<div class="s-areas__cards" role="list">
				<article class="area-card card1" style="background-color: var(--color-card-blue);" role="listitem">
					<h3>Comercio electrónico</h3>
					<p class="text-body">Infraestructuras optimizadas para plataformas como SAP Commerce Cloud u Ocado Smart Platform. Creamos entornos escalables y preparados para un alto volumen de tráfico.</p>
					<a href="/comercio-electronico" class="area-card__arrow" aria-label="Ver comercio electrónico">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
				</article>

				<article class="area-card card2" style="background-color: var(--color-card-yellow);" role="listitem">
					<h3>CDN, WAF &amp; Edge Security</h3>
					<p class="text-body">Aumenta la velocidad y seguridad de tu web con Cloudflare. Configuramos CDN, WAF y sistemas Zero Trust para proteger y optimizar tus aplicaciones.</p>
					<a href="/cdn-waf-seguridad-edge-cloudflare" class="area-card__arrow" aria-label="Ver CDN, WAF y Edge Security">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
				</article>

				<article class="area-card card3" style="background-color: var(--color-card-teal);" role="listitem">
					<h3>Big Data &amp; Cloud Analytics</h3>
					<p class="text-body">Arquitecturas de datos en Google Cloud Platform con dbt, BigQuery y Dataflow. Transformamos la información en decisiones útiles para tu negocio.</p>
					<a href="/big-data-cloud-analytics" class="area-card__arrow" aria-label="Ver Big Data y Cloud Analytics">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
				</article>

				<article class="area-card card4" style="background-color: var(--color-card-pink);" role="listitem">
					<h3>Integración de sistemas</h3>
					<p class="text-body">Conectamos sistemas complejos mediante Apache Camel, Talend o Gravitee API Manager, garantizando fluidez y trazabilidad.</p>
					<a href="/integracion-de-sistemas" class="area-card__arrow" aria-label="Ver Integración de sistemas">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
				</article>

				<article class="area-card card5" style="background-color: var(--color-card-green);" role="listitem">
					<h3>Desarrollo backend a medida</h3>
					<p class="text-body">APIs, microservicios y soluciones escalables. Diseñamos sistemas sólidos, listos para evolucionar contigo.</p>
					<a href="/ingenieria-greenfield-y-sistemas-criticos" class="area-card__arrow" aria-label="Ver Desarrollo backend a medida">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
				</article>
			</div>
		</div>
	</section>

	<!-- ══════ SECTION 5: CTA ══════ -->
	<section class="s-cta" aria-label="Contacta con nosotros">
		<div class="container s-cta__inner">
			<h2 class="s-cta__heading">{ctaHeading}</h2>
			{ctaSubtitle && <p class="text-sub s-cta__subtitle">{ctaSubtitle}</p>}
			{ctaBody && <p class="text-body s-cta__body">{ctaBody}</p>}
			<a href="/contacto" class="btn btn-light">Contacta ahora</a>
		</div>
	</section>
</Base>


<style>
	/* ═══ HERO — mobile-first ═══ */
	.s-hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		min-height: auto;
		padding: 16px 0 40px;
		/* Offset for fixed header */
		padding-top: calc(80px + 16px);
		background-image: url("/assets/cubo-home.svg");
		background-position: center center;
		background-repeat: no-repeat;
		background-size: auto;
	}

	.s-hero__kicker {
		margin-top: var(--widget-spacing);
	}

	.s-hero__kicker :global(p) {
		font-size: var(--text-sub-size, 26px);
		font-weight: var(--text-sub-weight, 500);
		line-height: var(--text-sub-lh, 30px);
	}

	.s-hero__body {
		margin-top: 24px;
	}
	.s-hero__body p {
		font-size: 20px;
		font-weight: 300;
		line-height: 26px;
		margin-block-end: 12px;
	}

	.s-hero .btn {
		margin-top: 32px;
	}

	@media (min-width: 768px) {
		.s-hero {
			padding: 0;
			padding-top: 0;
			min-height: calc(100vh - 150px);
		}
	}

	/* ═══ TECH SECTION — dark bg, 2-col ═══ */
	.s-tech {
		background-color: var(--color-primary);
		padding: 32px 0;
	}

	.s-tech__inner {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.s-tech__col-left h2 {
		color: var(--color-secondary);
	}

	.s-tech__subtitle-wrap :global(p) {
		color: var(--color-secondary);
		font-size: var(--text-sub-size, 26px);
		font-weight: var(--text-sub-weight, 500);
		line-height: var(--text-sub-lh, 30px);
	}

	.s-tech__body-wrap :global(p) {
		color: var(--color-secondary);
		margin-top: 16px;
		font-size: 20px;
		font-weight: 300;
		line-height: 26px;
	}

	@media (min-width: 768px) {
		.s-tech { padding: 40px 0; }
		.s-tech__inner { flex-direction: row; align-items: center; gap: 40px; }
		.s-tech__col-left,
		.s-tech__col-right { flex: 1; }
	}

	@media (min-width: 1025px) {
		.s-tech { padding: 80px 0; }
	}

	/* ═══ CLOUDFLARE SECTION — centered bordered card ═══ */
	.s-cf {
		padding: 40px 0;
	}

	.s-cf__wrapper {
		display: flex;
		justify-content: center;
	}

	.s-cf__card {
		width: 100%;
		border: 1px solid var(--color-primary);
		padding: 32px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.s-cf__logo {
		margin-bottom: 24px;
	}

	.s-cf__desc {
		margin-top: 24px;
	}

	.s-cf__features {
		display: flex;
		flex-direction: column;
		gap: 16px;
		margin: 32px 0;
		width: 100%;
	}

	.s-cf__feature {
		text-align: center;
	}

	.s-cf__feature p {
		font-size: 20px;
		font-weight: 300;
		line-height: 26px;
	}

	@media (min-width: 768px) {
		.s-cf { padding: 80px 0; }
		.s-cf__card { width: 90%; max-width: 1000px; }
		.s-cf__features { flex-direction: row; gap: 6px; }
		.s-cf__feature { flex: 1; }
	}

	@media (min-width: 1025px) {
		.s-cf__card { width: 80%; }
	}

	/* ═══ ÁREAS — 2-col with sticky cards ═══ */
	.s-areas {
		padding: 40px 0;
	}

	.s-areas__inner {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.s-areas__header .text-sub {
		margin-top: var(--widget-spacing);
	}

	.s-areas__cards {
		display: flex;
		flex-direction: column;
		gap: 120px;
	}

	/* Individual cards */
	.area-card {
		border-radius: var(--card-radius);
		box-shadow: var(--card-shadow);
		padding: 24px;
		display: flex;
		flex-direction: column;
	}

	.area-card h3 {
		margin-bottom: 0;
	}

	.area-card .text-body {
		margin-top: 0;
	}

	.area-card__arrow {
		display: flex;
		justify-content: flex-end;
		color: var(--color-primary);
		margin-top: 16px;
		text-decoration: none;
	}

	@media (min-width: 768px) {
		.s-areas { padding: 80px 0; }
		.s-areas__inner { flex-direction: row; gap: 60px; }

		.s-areas__header {
			flex: 0 0 auto;
			max-width: 400px;
			position: sticky;
			top: 120px;
			align-self: flex-start;
			z-index: 1;
		}

		.s-areas__cards {
			flex: 1;
			gap: 300px;
		}

		/* Sticky positions (from custom.css — exact values) */
		.card1 { position: sticky; top: calc(50% - 150px); z-index: 1; }
		.card2 { position: sticky; top: calc(50% - 130px); z-index: 2; }
		.card3 { position: sticky; top: calc(50% - 110px); z-index: 3; }
		.card4 { position: sticky; top: calc(50% - 90px);  z-index: 4; }
		.card5 { position: sticky; top: calc(50% - 70px);  z-index: 5; }
	}

	/* ═══ CTA — dark bg ═══ */
	.s-cta {
		background-color: var(--color-primary);
		padding: 80px 0;
	}

	.s-cta__heading {
		color: var(--color-secondary);
		width: 100%;
	}

	.s-cta__subtitle {
		color: var(--color-secondary);
	}

	.s-cta__body {
		color: var(--color-secondary);
		margin-top: 16px;
	}

	.s-cta .btn {
		margin-top: 32px;
	}

	@media (min-width: 768px) {
		.s-cta__heading { width: 70%; }
	}

	@media (min-width: 1025px) {
		.s-cta { padding: 80px 0; }
	}
</style>
