---
/**
 * Homepage — CMS-driven content, pixel-perfect layout.
 *
 * Content source: pages/home (EmDash CMS)
 * PT sections split by h2 headings:
 *   - hero: blocks before first h2
 *   - "~ Tecnología que impulsa tu negocio": h2 + body
 *   - "~ Áreas de especialización": h2 + subtitle
 *
 * CTA block sourced from cta_global widget area (issue #5).
 * Service cards and footer list derived from services collection.
 * Section 3 (Cloudflare Partner) driven by partners collection (issue #6).
 */
import { getEmDashEntry, getEmDashCollection } from "emdash";
import CloudflarePartner from "../components/CloudflarePartner.astro";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import CtaGlobal from "../components/CtaGlobal.astro";
import { getUiLabels } from "../utils/ui-labels";
import { t } from "../i18n/ui";

const locale = Astro.currentLocale || "es";
const { entry, cacheHint } = await getEmDashEntry("pages", "home", { locale });
if (!entry) return Astro.redirect("/404");
Astro.cache.set(cacheHint);

const { title, content, excerpt } = entry.data;

// Fetch services collection for cards and footer
const { entries: serviceEntries } = await getEmDashCollection("services", {
	orderBy: { created_at: "asc" },
	locale,
});
const services = serviceEntries ?? [];

const labels = await getUiLabels();
const heroServicesBtn = labels.get("footer_headings", "hero_services_btn", "Nuestros servicios");

// Split PT content by h2 headings into named sections
type Section = { heading: string; blocks: any[] };
const sections: Section[] = [];
let currentSection: Section = { heading: "", blocks: [] };

for (const block of content || []) {
	if (block._type === "block" && block.style === "h2") {
		if (currentSection.heading || currentSection.blocks.length > 0) {
			sections.push(currentSection);
		}
		const headingText = block.children?.map((c: any) => c.text).join("") || "";
		currentSection = { heading: headingText, blocks: [] };
	} else {
		currentSection.blocks.push(block);
	}
}
if (currentSection.heading || currentSection.blocks.length > 0) {
	sections.push(currentSection);
}

// Named section extraction
const heroSection = sections[0]; // blocks before first h2
const techSection = sections.find((s) => s.heading.includes("Tecnología") || s.heading.includes("Technology"));
const areasSection = sections.find((s) => s.heading.includes("Áreas") || s.heading.includes("Areas"));


// Extract tech subtitle (first block with marks) and body (second block)
const techSubtitleBlock = techSection?.blocks[0];
const techBodyBlock = techSection?.blocks[1];

// Extract areas subtitle
const areasSubtitle = areasSection?.blocks[0]?.children?.map((c: any) => c.text).join("") || "";
---

<Base
	title={title}
	description={excerpt || `${title} — Server Startup`}
>
	<!-- ══════ SECTION 1: HERO ══════ -->
	<section class="s-hero" aria-label={t("aria.hero_intro")}>
		<div class="container s-hero__inner">
			<h1>{title}</h1>
			{heroSection?.blocks.length > 0 && (
				<div class="s-hero__kicker">
					<PortableText value={[heroSection.blocks[0]]} />
				</div>
			)}
			{heroSection?.blocks.length > 1 && (
				<div class="s-hero__body">
					<PortableText value={heroSection.blocks.slice(1)} />
				</div>
			)}
			<a href="#areas-especializacion" class="btn btn-dark">{heroServicesBtn}</a>
		</div>
	</section>

	<!-- ══════ SECTION 2: TECNOLOGÍA QUE IMPULSA TU NEGOCIO ══════ -->
	{techSection && (
		<section class="s-tech" aria-label={techSection.heading}>
			<div class="container s-tech__inner">
				<div class="s-tech__col-left">
					<h2>{techSection.heading}</h2>
				</div>
				<div class="s-tech__col-right">
					{techSubtitleBlock && (
						<div class="s-tech__subtitle-wrap">
							<PortableText value={[techSubtitleBlock]} />
						</div>
					)}
					{techBodyBlock && (
						<div class="s-tech__body-wrap">
							<PortableText value={[techBodyBlock]} />
						</div>
					)}
				</div>
			</div>
		</section>
	)}

	<!-- ══════ SECTION 3: CLOUDFLARE PARTNER (CMS-driven) ══════ -->
	<CloudflarePartner />

	<!-- ══════ SECTION 4: ÁREAS DE ESPECIALIZACIÓN (CMS-driven) ══════ -->
	<section class="s-areas" id="areas-especializacion" aria-label={areasSection?.heading || labels.get("footer_headings", "services_title", "Áreas de especialización")}>
		<div class="container s-areas__inner">
			<!-- Left: sticky header -->
			<div class="s-areas__header">
				<h2>{areasSection?.heading || `~ ${labels.get("footer_headings", "services_title", "Áreas de especialización")}`}</h2>
				<p class="text-sub">{areasSubtitle}</p>
			</div>

			<!-- Right: stacking cards from services collection -->
			<div class="s-areas__cards" role="list">
				{services.map((svc, i) => {
					const d = svc.data as any;
					const cardColor = d.color || '#BFEDEE';
					return (
						<article class={`area-card card${i + 1}`} style={`background-color: ${cardColor};`} role="listitem">
							<h3>{d.title}</h3>
							<p class="text-body">{d.excerpt}</p>
							<a href={`/${svc.id}`} class="area-card__arrow" aria-label={t("aria.view_service", { title: d.title })}>
								<svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
							</a>
						</article>
					);
				})}
			</div>
		</div>
	</section>

	<!-- ══════ SECTION 5: CTA (from cta_global widget) ══════ -->
	<CtaGlobal />
</Base>


<style>
	/* ═══ HERO — mobile-first ═══ */
	.s-hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		min-height: auto;
		padding: 16px 0 40px;
		/* Offset for fixed header */
		padding-top: calc(80px + 16px);
		background-image: url("/assets/cubo-home.svg");
		background-position: center center;
		background-repeat: no-repeat;
		background-size: auto;
	}

	.s-hero__kicker {
		margin-top: var(--widget-spacing);
	}

	.s-hero__kicker :global(p) {
		font-size: var(--text-sub-size, 26px);
		font-weight: var(--text-sub-weight, 500);
		line-height: var(--text-sub-lh, 30px);
	}

	.s-hero__body {
		margin-top: 24px;
	}
	.s-hero__body p {
		font-size: 20px;
		font-weight: 300;
		line-height: 26px;
		margin-block-end: 12px;
	}

	.s-hero .btn {
		margin-top: 32px;
	}

	@media (min-width: 768px) {
		.s-hero {
			padding: 0;
			padding-top: 0;
			min-height: calc(100vh - 150px);
		}
	}

	/* ═══ TECH SECTION — dark bg, 2-col ═══ */
	.s-tech {
		background-color: var(--color-primary);
		padding: 32px 0;
	}

	.s-tech__inner {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.s-tech__col-left h2 {
		color: var(--color-secondary);
	}

	.s-tech__subtitle-wrap :global(p) {
		color: var(--color-secondary);
		font-size: var(--text-sub-size, 26px);
		font-weight: var(--text-sub-weight, 500);
		line-height: var(--text-sub-lh, 30px);
	}

	.s-tech__body-wrap :global(p) {
		color: var(--color-secondary);
		margin-top: 16px;
		font-size: 20px;
		font-weight: 300;
		line-height: 26px;
	}

	@media (min-width: 768px) {
		.s-tech { padding: 40px 0; }
		.s-tech__inner { flex-direction: row; align-items: center; gap: 40px; }
		.s-tech__col-left,
		.s-tech__col-right { flex: 1; }
	}

	@media (min-width: 1025px) {
		.s-tech { padding: 80px 0; }
	}

	/* ═══ CLOUDFLARE SECTION — centered bordered card ═══ */
	.s-cf {
		padding: 40px 0;
	}

	.s-cf__wrapper {
		display: flex;
		justify-content: center;
	}

	.s-cf__card {
		width: 100%;
		border: 1px solid var(--color-primary);
		padding: 32px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.s-cf__logo {
		margin-bottom: 24px;
	}

	.s-cf__desc {
		margin-top: 24px;
	}

	.s-cf__features {
		display: flex;
		flex-direction: column;
		gap: 16px;
		margin: 32px 0;
		width: 100%;
	}

	.s-cf__feature {
		text-align: center;
	}

	.s-cf__feature p {
		font-size: 20px;
		font-weight: 300;
		line-height: 26px;
	}

	@media (min-width: 768px) {
		.s-cf { padding: 80px 0; }
		.s-cf__card { width: 90%; max-width: 1000px; }
		.s-cf__features { flex-direction: row; gap: 6px; }
		.s-cf__feature { flex: 1; }
	}

	@media (min-width: 1025px) {
		.s-cf__card { width: 80%; }
	}

	/* ═══ ÁREAS — 2-col with sticky cards ═══ */
	.s-areas {
		padding: 40px 0;
	}

	.s-areas__inner {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.s-areas__header .text-sub {
		margin-top: var(--widget-spacing);
	}

	.s-areas__cards {
		display: flex;
		flex-direction: column;
		gap: 120px;
	}

	/* Individual cards */
	.area-card {
		border-radius: var(--card-radius);
		box-shadow: var(--card-shadow);
		padding: 24px;
		display: flex;
		flex-direction: column;
	}

	.area-card h3 {
		margin-bottom: 0;
	}

	.area-card .text-body {
		margin-top: 0;
	}

	.area-card__arrow {
		display: flex;
		justify-content: flex-end;
		color: var(--color-primary);
		margin-top: 16px;
		text-decoration: none;
	}

	@media (min-width: 768px) {
		.s-areas { padding: 80px 0; }
		.s-areas__inner { flex-direction: row; gap: 60px; }

		.s-areas__header {
			flex: 0 0 auto;
			max-width: 400px;
			position: sticky;
			top: 120px;
			align-self: flex-start;
			z-index: 1;
		}

		.s-areas__cards {
			flex: 1;
			gap: 300px;
		}

		/* Sticky positions (from custom.css — exact values) */
		.card1 { position: sticky; top: calc(50% - 150px); z-index: 1; }
		.card2 { position: sticky; top: calc(50% - 130px); z-index: 2; }
		.card3 { position: sticky; top: calc(50% - 110px); z-index: 3; }
		.card4 { position: sticky; top: calc(50% - 90px);  z-index: 4; }
		.card5 { position: sticky; top: calc(50% - 70px);  z-index: 5; }
	}

	/* ═══ CTA — dark bg ═══ */
	.s-cta {
		background-color: var(--color-primary);
		padding: 80px 0;
	}

	.s-cta__heading {
		color: var(--color-secondary);
		width: 100%;
	}

	.s-cta__subtitle {
		color: var(--color-secondary);
	}

	.s-cta__body {
		color: var(--color-secondary);
		margin-top: 16px;
	}

	.s-cta .btn {
		margin-top: 32px;
	}

	@media (min-width: 768px) {
		.s-cta__heading { width: 70%; }
	}

	@media (min-width: 1025px) {
		.s-cta { padding: 80px 0; }
	}
</style>
