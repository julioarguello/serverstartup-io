---
/**
 * Homepage (ES) — /
 * Thin wrapper around HomepageContent component.
 * All layout logic lives in HomepageContent.astro (DRY).
 */
import Base from "../layouts/Base.astro";
import HomepageContent from "../components/HomepageContent.astro";
import { getEmDashEntry } from "emdash";

const locale = Astro.currentLocale || "es";
const { entry } = await getEmDashEntry("pages", "home", { locale });
const { title, excerpt } = entry?.data ?? { title: "Server Startup", excerpt: "" };
---

<Base
	title={title}
	description={excerpt || `${title} — Server Startup`}
>
	<HomepageContent />
</Base>


<style is:global>
	@import "../styles/homepage.css";
</style>
