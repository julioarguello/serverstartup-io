---
/**
 * Política de privacidad — legal page, content from CMS.
 * noindex, nofollow.
 */
import { getEmDashEntry } from "emdash";
import { entryAlternatePath } from "../utils/alternate";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";

const { entry, cacheHint } = await getEmDashEntry("pages", "politica-de-privacidad");
if (!entry) return Astro.rewrite("/404");
Astro.cache.set(cacheHint);

const { title, content, excerpt } = entry.data;
// Slugs are translated across locales — resolve the counterpart via the CMS (#291)
const altPath = entry ? await entryAlternatePath("pages", entry.data.id, "es") : null;

---

<Base
	title={title}
	description={excerpt || `${title} — Server Startup`}
	robots="noindex, nofollow"
	altPath={altPath}
>
	<section class="legal" aria-label={title}>
		<div class="container legal-inner">
			<h1>{title}</h1>
			{content && <PortableText value={content} />}
		</div>
	</section>
</Base>

<style>
	@import "../styles/legal.css";
</style>
