---
/**
 * EmDash preview surface for the `pages` collection (#331).
 *
 * This route is NOT part of the public site: EmDash's admin builds its
 * preview link from the default pattern `/{collection}/{id}` — measured
 * 2026-08-23, it POSTs to …/preview-url and gets back
 * `/pages/<ULID>?_preview=<token>`. So the route has to stay, but until
 * #331 it also answered 200 for `/pages/<slug>` with a canonical pointing
 * at itself: the same CMS text on two URLs, the duplicate wearing a bare
 * template, and `/pages/home` exposing the homepage under a second title.
 *
 * Now it serves exactly one purpose. A preview request renders (noindex,
 * belt and braces — the token is unguessable and nothing links here);
 * anything else is a human or a crawler who should be on the real page,
 * and gets a 301 there.
 */
import { getEmDashEntry, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const locale = Astro.currentLocale || "es";
// The param may be a slug OR the entry ULID (that is what the admin links).
// Either resolves; `page.id` comes back as the slug in both cases.
const { entry: page, cacheHint } = await getEmDashEntry("pages", slug, { locale });

if (!page) {
	return Astro.rewrite("/404");
}

if (!Astro.url.searchParams.has("_preview")) {
	// Canonical home of this entry, derived — never a slug→route table:
	// locale prefix + slug, and `home` is the locale root.
	const entryLocale = (page.data as { locale?: string }).locale || locale;
	const prefix = entryLocale === "en" ? "/en" : "";
	const target = page.id === "home" ? prefix || "/" : `${prefix}/${page.id}`;
	return Astro.redirect(target, 301);
}

Astro.cache.set(cacheHint);
---

<Base
	title={page.data.title}
	robots="noindex, nofollow"
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="page-article">
		<header class="page-header">
			<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
		</header>

		<div class="page-content">
			<PortableText value={page.data.content} />
		</div>
	</article>
</Base>

<style>
	.page-article {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 64px 24px 64px;
	}

	.page-header {
		margin-bottom: 32px;
	}

	.page-title {
		font-size: clamp(28px, 4vw, 40px);
		font-weight: 700;
		line-height: 1.2;
	}

	.page-content :global(p) {
		margin-bottom: 1.5em;
	}

	.page-content :global(h2) {
		font-size: 28px;
		margin-top: 2em;
		margin-bottom: 0.75em;
	}

	.page-content :global(h3) {
		font-size: 22px;
		margin-top: 1.75em;
		margin-bottom: 0.5em;
	}

	.page-content :global(blockquote) {
		margin: 1.5em 0;
		padding-left: 24px;
		border-left: 3px solid var(--color-border);
		color: var(--color-text-muted);
	}

	.page-content :global(pre) {
		margin: 1.5em 0;
		padding: 16px;
		background: var(--color-surface);
		border-radius: var(--radius);
		overflow-x: auto;
		font-family: monospace;
		font-size: 14px;
	}

	.page-content :global(code) {
		font-family: monospace;
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.15em 0.3em;
		border-radius: var(--radius);
	}

	.page-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.page-content :global(ul),
	.page-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: 20px;
	}

	.page-content :global(li) {
		margin-bottom: 0.5em;
	}
</style>
