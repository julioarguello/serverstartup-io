---
import { getEmDashEntry, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const locale = Astro.currentLocale || "es";
const { entry: page, cacheHint } = await getEmDashEntry("pages", slug, { locale });

if (!page) {
	return Astro.redirect("/404");
}

Astro.cache.set(cacheHint);
---

<Base
	title={page.data.title}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="page-article">
		<header class="page-header">
			<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
		</header>

		<div class="page-content">
			<PortableText value={page.data.content} />
		</div>
	</article>
</Base>

<style>
	.page-article {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 64px 24px 64px;
	}

	.page-header {
		margin-bottom: 32px;
	}

	.page-title {
		font-size: clamp(28px, 4vw, 40px);
		font-weight: 700;
		line-height: 1.2;
	}

	.page-content :global(p) {
		margin-bottom: 1.5em;
	}

	.page-content :global(h2) {
		font-size: 28px;
		margin-top: 2em;
		margin-bottom: 0.75em;
	}

	.page-content :global(h3) {
		font-size: 22px;
		margin-top: 1.75em;
		margin-bottom: 0.5em;
	}

	.page-content :global(blockquote) {
		margin: 1.5em 0;
		padding-left: 24px;
		border-left: 3px solid rgba(30,30,30,0.15);
		color: rgba(30,30,30,0.5);
	}

	.page-content :global(pre) {
		margin: 1.5em 0;
		padding: 16px;
		background: #f5f5f5;
		border-radius: 4px;
		overflow-x: auto;
		font-family: monospace;
		font-size: 14px;
	}

	.page-content :global(code) {
		font-family: monospace;
		font-size: 0.9em;
		background: #f5f5f5;
		padding: 0.15em 0.3em;
		border-radius: 4px;
	}

	.page-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.page-content :global(ul),
	.page-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: 20px;
	}

	.page-content :global(li) {
		margin-bottom: 0.5em;
	}
</style>
