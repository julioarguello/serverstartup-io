---
/**
 * Dynamic service page.
 *
 * Layout matches original WordPress pattern:
 * 1. Hero — full-height, themed cube SVG bg, h1 + body + CTA button
 * 2. "~ Con qué te ayudamos" — dark bg, white text, service cards grid
 * 3. CTA — dark bg, white heading + light button
 *
 * Each service has a color-themed cube background SVG.
 */
import { getEmDashEntry, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import CtaGlobal from "../components/CtaGlobal.astro";
import MantraCloser from "../components/MantraCloser.astro";
import ServiceInstrument from "../components/service/ServiceInstrument.astro";
import CubeEmblem from "../components/CubeEmblem.astro";
import { FACE_BY_SLUG, SITE_BY_PATH } from "../utils/nav";
import { serviceJsonLd, breadcrumbJsonLd } from "../utils/jsonld";
import { entryAlternatePath } from "../utils/alternate";
import { getUiLabels } from "../utils/ui-labels";
import { excerptHtml, excerptPlain } from "../utils/excerpt";
import type { SiteSettings } from "../types";
const t = Astro.locals.t;

const { slug } = Astro.params;
const locale = Astro.currentLocale || "es";

// Try services first, then pages (mirrors en/[slug].astro)
let entry: any = null;
let cacheHint: any = null;
let entryCollection: "services" | "pages" = "services";

const svcResult = await getEmDashEntry("services", slug!, { locale });
if (svcResult.entry) {
	entry = svcResult.entry;
	cacheHint = svcResult.cacheHint;
} else {
	const pageResult = await getEmDashEntry("pages", slug!, { locale });
	if (pageResult.entry) {
		entry = pageResult.entry;
		cacheHint = pageResult.cacheHint;
		entryCollection = "pages";
	}
}

if (!entry) return Astro.rewrite("/404");
if (cacheHint) Astro.cache.set(cacheHint);

// Slugs are translated across locales — resolve the counterpart via the CMS (#291)
const altPath = await entryAlternatePath(entryCollection, entry.data.id, locale);

const settings = await getSiteSettings();
const defaultCtaLabel = (settings as SiteSettings).defaultCtaLabel || "Contacta ahora";

const { title, content, excerpt } = entry.data;

// Theme color from CMS entry (fallback to teal)
const accentColor = entry.data.color || "#1E1E1E";
const emblemKey = FACE_BY_SLUG[slug!] ?? SITE_BY_PATH[Astro.url.pathname.replace(/\/$/, "")];

// CTA label from CMS (fallback to site settings default)
const ctaLabel = entry.data.cta_label || defaultCtaLabel;

// Locale-aware URL prefix ("" for ES default, "/en" for English)
const localePrefix = locale === "es" ? "" : `/${locale}`;
const labels = await getUiLabels(locale);
---

<Base
	title={title}
	description={excerpt ? excerptPlain(excerpt) : `${title} — Server Startup`}
	altPath={altPath}
>
	<script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd({
		siteUrl: Astro.site?.origin!,
		name: title,
		description: excerpt ? excerptPlain(excerpt) : `${title} — Server Startup`,
		slug: slug!,
		locale,
	}))} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd({
		siteUrl: Astro.site?.origin!,
		locale,
		homeName: (settings as SiteSettings).title || "Server Startup",
		trail: [{ name: title, path: `/${slug}` }],
	}))} />
	<!-- Mobile: the section emblem lives as a fixed full-viewport watermark
	     instead of an in-flow icon (always in view, adds no scroll — #216) -->
	<div class="s-emblem-bg" aria-hidden="true">
		<CubeEmblem color={accentColor} faceKey={emblemKey} size={340} />
	</div>

	<!-- ══════ HERO — compact, solid cube glyph in the discipline color ══════ -->
	<section class="s-hero" aria-label={title}>
		<div class="container s-hero__inner">
			<div class="s-hero__copy">
				<CubeEmblem class="s-emblem-mini" color={accentColor} faceKey={emblemKey} size={104} />
				<h1>{title}</h1>
				{excerpt && (
					<div class="s-hero__body">
						<p class="text-body" set:html={excerptHtml(excerpt)} />
					</div>
				)}
				<a href={`${localePrefix}/${locale === "en" ? "contact" : "contacto"}`} class="btn btn-dark">{ctaLabel}</a>
			</div>
		</div>
	</section>

	<!-- ══════ CONTENT — discipline instrument (or legacy fallback) ══════ -->
	{content && (
		<ServiceInstrument
			slug={slug!}
			content={content as any[]}
			ctaLabel={ctaLabel}
			contactPath={`${localePrefix}/${locale === "en" ? "contact" : "contacto"}`}
			labels={labels}
		/>
	)}

	<div class="container mantra-wrap">
		<MantraCloser />
	</div>

	<!-- ══════ CTA (from cta_global widget) ══════ -->
	<CtaGlobal />
</Base>

<style is:global define:vars={{ accentColor }}>
	@import "../styles/service.css";
</style>
