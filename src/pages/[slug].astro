---
/**
 * Dynamic service page.
 *
 * Layout matches original WordPress pattern:
 * 1. Hero — full-height, themed cube SVG bg, h1 + body + CTA button
 * 2. "~ Con qué te ayudamos" — dark bg, white text, service cards grid
 * 3. CTA — dark bg, white heading + light button
 *
 * Each service has a color-themed cube background SVG.
 */
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";

const { slug } = Astro.params;
const { entry, cacheHint } = await getEmDashEntry("services", slug!);
if (!entry) return Astro.redirect("/404");
Astro.cache.set(cacheHint);

const { title, content, excerpt } = entry.data;

// Theme colors per slug — matching original Elementor cube tints
const themeColors: Record<string, string> = {
	"comercio-electronico": "#B5E6F7",
	"cdn-waf-seguridad-edge-cloudflare": "#FDEBB6",
	"big-data-cloud-analytics": "#BFEDEE",
	"integracion-de-sistemas": "#ECDCE3",
	"ingenieria-greenfield-y-sistemas-criticos": "#C5EFCD",
};
const accentColor = themeColors[slug!] || "#BFEDEE";

// CTA label from CMS (fallback to generic)
const ctaLabel = (entry.data as any).cta_label || "Contacta ahora";
---

<Base
	title={title}
	description={excerpt || `${title} — Server Startup`}
>
	<!-- ══════ HERO — full height, themed cube bg ══════ -->
	<section class="s-hero" aria-label={title}>
		<div class="container s-hero__inner">
			<h1>{title}</h1>
			{excerpt && (
				<div class="s-hero__body">
					<p class="text-body">{excerpt}</p>
				</div>
			)}
			<a href="/contacto" class="btn btn-dark">{ctaLabel}</a>
		</div>
	</section>

	<!-- ══════ CONTENT — dark bg section + portable text ══════ -->
	{content && (
		<section class="s-content" aria-label="Contenido">
			<div class="container s-content__inner">
				<PortableText value={content} />
			</div>
		</section>
	)}

	<!-- ══════ CTA ══════ -->
	<section class="s-cta" aria-label="Contacta con nosotros">
		<div class="container s-cta__inner">
			<h2 class="s-cta__heading">¿Listo para optimizar tu infraestructura digital?</h2>
			<p class="text-sub s-cta__subtitle">Cuéntanos tu reto y te daremos una visión honesta de cómo resolverlo.</p>
			<a href="/contacto" class="btn btn-light">Contacta ahora</a>
		</div>
	</section>
</Base>

<style define:vars={{ accentColor }}>
	/* ═══ HERO — full height with themed cube bg ═══ */
	.s-hero {
		min-height: auto;
		padding: calc(80px + 16px) 0 40px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background-image: url("https://www.serverstartup.io/wp-content/uploads/cubo-home.svg");
		background-position: center center;
		background-repeat: no-repeat;
		background-size: auto;
	}

	.s-hero__body {
		margin-top: 24px;
		max-width: 700px;
	}

	.s-hero .btn {
		margin-top: 32px;
	}

	@media (min-width: 768px) {
		.s-hero {
			min-height: calc(100vh - 150px);
			padding: 0;
		}
	}

	/* ═══ CONTENT ═══ */
	.s-content {
		background-color: var(--color-primary);
		padding: 40px 0;
	}

	.s-content__inner {
		color: var(--color-secondary);
	}

	.s-content__inner :global(h2) {
		color: var(--color-secondary);
		margin-bottom: 24px;
	}

	.s-content__inner :global(h3) {
		color: var(--color-secondary);
		margin-bottom: 16px;
	}

	.s-content__inner :global(p) {
		color: var(--color-secondary);
		max-width: 700px;
		font-size: 20px;
		font-weight: 300;
		line-height: 26px;
		margin-block-end: 12px;
	}

	.s-content__inner :global(ul) {
		color: var(--color-secondary);
		list-style: disc;
		padding-left: 24px;
	}

	.s-content__inner :global(li) {
		color: var(--color-secondary);
		font-size: 20px;
		font-weight: 300;
		line-height: 28px;
	}

	@media (min-width: 768px) {
		.s-content { padding: 80px 0; }
	}

	/* ═══ CTA ═══ */
	.s-cta {
		background-color: var(--color-primary);
		padding: 60px 0;
	}

	.s-cta__heading {
		color: var(--color-secondary);
		width: 100%;
	}

	.s-cta__subtitle {
		color: var(--color-secondary);
	}

	.s-cta .btn {
		margin-top: 32px;
	}

	@media (min-width: 768px) {
		.s-cta { padding: 80px 0; }
		.s-cta__heading { width: 70%; }
	}
</style>
