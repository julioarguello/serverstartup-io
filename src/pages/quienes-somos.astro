---
/**
 * Quiénes Somos — hero text from CMS, team members from CMS collection.
 * 1. Hero — h1 + body from pages/quienes-somos content
 * 2. "~ El equipo" — dark bg, 4-col grid of team member cards from members collection
 * 3. Values — text from CMS content (h2 + paragraph at end of page content)
 */
import { getEmDashEntry, getEmDashCollection } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { getUiLabels } from "../utils/ui-labels";
const t = Astro.locals.t;

const locale = Astro.currentLocale || "es";
const { entry, cacheHint } = await getEmDashEntry("pages", "quienes-somos", { locale });
if (!entry) return Astro.redirect("/404");
Astro.cache.set(cacheHint);

const { title, content, excerpt } = entry.data;

const { entries: members } = await getEmDashCollection("members", {
	limit: 50,
	orderBy: { title: "asc" },
});

const labels = await getUiLabels(locale);
const teamHeading = labels.get("footer_headings", "team_title", locale === "en" ? "~ The team" : "~ El equipo");

// Split content: first blocks are hero, blocks after "~ Nuestros valores" h2 are the values section
const heroBlocks: any[] = [];
const valuesBlocks: any[] = [];
let inValues = false;
for (const block of content || []) {
	if (block._type === 'block' && block.style === 'h2') {
		inValues = true;
		continue; // skip the h2 itself, we render it in the template
	}
	if (inValues) {
		valuesBlocks.push(block);
	} else {
		heroBlocks.push(block);
	}
}
---

<Base
	title={title}
	description={excerpt || `${title} — Server Startup`}
>
	<!-- ══════ HERO ══════ -->
	<section class="s-hero" aria-label={title}>
		<div class="container s-hero__inner">
			<h1>{title}</h1>
			{heroBlocks.length > 0 && (
				<div class="s-hero__body">
					<PortableText value={heroBlocks} />
				</div>
			)}
		</div>
	</section>

	<!-- ══════ TEAM — dark bg, 4-col grid ══════ -->
	<section class="s-team" aria-label={t("team_section")}>
		<div class="container s-team__inner">
			<h2>{teamHeading}</h2>
			<div class="s-team__grid" role="list">
				{members.map((member) => (
					<article class="team-card" role="listitem">
						<div class="team-card__photo">
							{member.data.featured_image?.src
								? <img src={member.data.featured_image.src} alt={member.data.title} loading="lazy" />
								: <div class="team-card__placeholder">{member.data.title?.charAt(0) || "?"}</div>
							}
						</div>
						<h3 class="team-card__name">{member.data.title}</h3>
						{member.data.excerpt && <p class="team-card__role">{member.data.excerpt}</p>}
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- ══════ VALUES — dark bg ══════ -->
	{valuesBlocks.length > 0 && (
		<section class="s-values" aria-label={t("values_section")}>
			<div class="container s-values__inner">
				<PortableText value={valuesBlocks} />
			</div>
		</section>
	)}
</Base>

<style>
	/* ═══ HERO ═══ */
	.s-hero {
		padding: calc(80px + 24px) 0 60px;
	}

	.s-hero__body {
		margin-top: 16px;
		max-width: 700px;
	}

	.s-hero__body :global(p) {
		font-size: 20px;
		font-weight: 300;
		line-height: 26px;
	}

	@media (min-width: 768px) {
		.s-hero { padding: 160px 0 80px; }
	}

	/* ═══ TEAM — dark bg ═══ */
	.s-team {
		background-color: var(--color-primary);
		padding: 40px 0;
	}

	.s-team__inner h2 {
		color: var(--color-secondary);
		margin-bottom: 40px;
	}

	.s-team__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
	}

	.team-card {
		text-align: left;
	}

	.team-card__photo {
		width: 100%;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: #3a3a3a;
		margin-bottom: 16px;
	}

	.team-card__photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.team-card__placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 48px;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.3);
		background: #3a3a3a;
	}

	.team-card__name {
		color: var(--color-secondary);
		font-size: 20px;
		font-weight: 700;
		margin-bottom: 2px;
	}

	.team-card__role {
		color: var(--color-secondary);
		font-size: 16px;
		font-weight: 400;
		line-height: 22px;
		margin-bottom: 8px;
	}

	@media (min-width: 768px) {
		.s-team { padding: 80px 0; }
		.s-team__grid {
			grid-template-columns: repeat(4, 1fr);
			gap: 40px;
		}
	}

	/* ═══ VALUES — dark bg ═══ */
	.s-values {
		background-color: var(--color-primary);
		padding: 60px 0 80px;
	}

	.s-values__inner :global(p) {
		color: var(--color-secondary);
		max-width: 700px;
		font-size: 20px;
		font-weight: 300;
		line-height: 26px;
	}
</style>
