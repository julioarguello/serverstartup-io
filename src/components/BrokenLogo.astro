---
/**
 * BrokenLogo — the 404's cracked mark (#216, approved study v6).
 *
 * The logo keeps its exact shape and place; a thin lightning crack splits
 * the cube AND the light plate (pieces barely 4px apart, porcelain-style),
 * and the dark plate sits shaken behind (23° instead of its usual 10°).
 * No debris, no animation: the break IS the state.
 *
 * Purely decorative (aria-hidden) — the page copy says what happened.
 *
 * `class` lands on the svg, but a SCOPED rule in the calling page will not
 * match it: Astro stamps `data-astro-cid` on the elements written in that
 * page, and this svg is written here. Size it from a wrapper element, or with
 * a `:global()` rule, and measure the result — the class alone renders as if
 * nothing had been set.
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg
	class:list={["broken-logo", className]}
	viewBox="-45 -40 290 310"
	aria-hidden="true"
>
	<defs>
		<clipPath id="crk-l"><polygon points="122,-40 114,28 92,66 108,92 76,132 88,164 60,206 54,300 -45,300 -45,-40"></polygon></clipPath>
		<clipPath id="crk-r"><polygon points="122,-40 114,28 92,66 108,92 76,132 88,164 60,206 54,300 245,300 245,-40"></polygon></clipPath>
		<g id="crk-front">
			<rect x="-6" y="6" width="212" height="212" rx="30" fill="#CED4DA"></rect>
			<polygon points="100,14 186,64 100,114 14,64" fill="#E9ECEF"></polygon>
			<polygon points="14,64 100,114 100,214 14,164" fill="#E9ECEF"></polygon>
			<polygon points="100,114 186,64 186,164 100,214" fill="#F4F6F8"></polygon>
			<g fill="none" stroke="#1E1E1E" stroke-width="13" stroke-linejoin="round" stroke-linecap="round">
				<path d="M100,14 186,64 186,164 100,214 14,164 14,64 Z"></path>
				<path d="M14,64 100,114 186,64 M100,114 100,214"></path>
				<path d="M57,39 143,89 M143,39 57,89"></path>
				<path d="M57,89 57,189 M14,114 100,164 M143,89 143,189 M100,164 186,114"></path>
			</g>
		</g>
	</defs>
	<rect x="4" y="16" width="196" height="196" rx="28" fill="#1E1E1E" transform="rotate(23 100 114) translate(10,-6)"></rect>
	<use href="#crk-front" clip-path="url(#crk-l)" transform="translate(-4,2)"></use>
	<use href="#crk-front" clip-path="url(#crk-r)" transform="translate(5,-2)"></use>
</svg>
