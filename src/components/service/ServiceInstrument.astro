---
/**
 * ServiceInstrument — renders a service's Portable Text inside the instrument
 * of its discipline (design approved 2026-08-06, issue #156):
 *   cart (e-commerce) · terminal (integration) · bigquery (data) ·
 *   dashboard (edge security) · javadoc (greenfield)
 *
 * Content stays CMS-pure: the copy comes from the existing blocks
 * (see src/utils/panels.ts); instrument chrome strings come from the
 * panel_labels UI widget.
 */
import { PortableText } from "emdash/ui";
import TightMark from "./TightMark.astro";
import { parsePanelSections, mdNormalize, INSTRUMENT_BY_SLUG } from "../../utils/panels";
import RefsNoIndex from "./RefsNoIndex.astro";

// Closer blockquotes carry either the reference list (trailing comma) or the
// final motto — see RefsNoIndex.astro. Marks render tight everywhere.
const closerComponents = { mark: TightMark, block: { blockquote: RefsNoIndex } } as any;

interface Props {
	slug: string;
	content: any[];
	ctaLabel: string;
	contactPath: string;
	labels: { get: (widget: string, key: string, fallback: string) => string };
}
const { slug, content, ctaLabel, contactPath, labels } = Astro.props;

const kind = INSTRUMENT_BY_SLUG[slug] ?? "legacy";
const s = parsePanelSections(content);
const L = (k: string, fb: string) => labels.get("panel_labels", k, fb);

const leadLines = s.lead ? s.lead.split(/(?<=[.!?])\s+/).filter(Boolean) : [];

// bigquery: results grid comes from panel_labels (semicolon rows, comma cells)
const bqHead = L("bq_head", "Fila,metrica,linaje,ultima_ejecucion").split(",");
const bqRows = L("bq_rows", "").split(";").filter(Boolean).map((r) => r.split(","));

// dashboard: metric tiles from panel_labels; toggles from the content items
const cfTiles = L("cf_tiles", "").split(";").filter(Boolean).map((t) => t.split(","));

// javadoc: tag names zip with the content items
const jdTags = L("jd_tags", "pila,contrato,gobernanza,seguridad").split(",");

// Strings with characters that confuse Astro's JSX expression scanner
// (backticks, braces) are hoisted here — the frontmatter is real TypeScript.
const bqTab = L("bq_tab", "metricas_fiables.sql");
const bqRun = L("bq_run", "Ejecutar");
const bqMenu = L("bq_menu", "Guardar ▾   Programar   Compartir");
const bqCTop = L("bq_c_top", "-- ¿de qué números te fías?");
const bqL1 = L("bq_l1", "metrica, linaje, ultima_ejecucion");
const bqTable = L("bq_l2", "`gold.metricas_de_negocio`");
const bqL3 = L("bq_l3", "fiable = TRUE;");
const bqCBottom = L("bq_c_bottom", "-- lo garantizan 1.646 tests sobre 111 modelos dbt");
const bqStatus = L("bq_status", "Consulta completada (1,4 s) · el linaje de cada métrica, de la ingesta al análisis");
const bqNote = L("bq_note", "El dato que no cuadra no llega a gold. Ahí está el gobierno.");
const jdSig = L("jd_sig", "public Sistema construir(Pila pila, Contrato contrato) { … }");
---

{kind !== "legacy" ? (
	<section class="s-inst" aria-label={s.heading}>
		<div class="container s-inst__inner">
			{kind === "dashboard" && s.intro.length > 0 ? (
				<div class="s-inst__intro">
					<div class="s-partner">
						<a
							class="s-partner__logo"
							href="https://www.cloudflare.com/partners/"
							target="_blank"
							rel="noopener noreferrer"
						>
							<img
								src="/assets/cf-partner-network-stacked.png"
								alt="Cloudflare Partner Network"
								width="516"
								height="234"
								loading="lazy"
							/>
						</a>
						<div class="s-partner__copy"><PortableText value={[s.intro[0]]} components={{ mark: TightMark }} /></div>
					</div>
					{s.intro.length > 1 && <PortableText value={s.intro.slice(1)} components={{ mark: TightMark }} />}
				</div>
			) : (
				s.intro.length > 0 && <div class="s-inst__intro"><PortableText value={s.intro} components={{ mark: TightMark }} /></div>
			)}
			<h2 class="s-inst__heading">{s.heading}</h2>
			{kind === "dashboard" && s.leadBlocks.length > 0 && (
				<div class="s-inst__lead"><PortableText value={s.leadBlocks} components={{ mark: TightMark }} /></div>
			)}

			{kind === "cart" && (
				<div class="inst inst--light" role="group" aria-label={s.heading}>
					<div class="inst__bar">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="20" r="1.6"/><circle cx="17" cy="20" r="1.6"/><path d="M3 4h2l2.5 11.5h10L20 8H6"/></svg>
						<b>{L("cart_title", "Tu cesta")}</b>
						<span class="inst__muted">({s.items.length})</span>
						<span class="cart__banner">{L("cart_shipping_banner", "Envío gratis: cero handoffs")}</span>
					</div>
					<div class="cart__grid">
						<ul class="cart__items">
							{s.items.map((it) => (
								<li class="cart__item">
									<span class="cart__thumb" aria-hidden="true">
										<svg width="30" height="33" viewBox="0 0 100 110" fill="none" stroke="currentColor" stroke-width="6"><path d="M50 5 95 30v50L50 105 5 80V30Z"/><path d="M5 30l45 25 45-25M50 55v50"/></svg>
									</span>
									<span>
										<b class="cart__name">{it.label}</b>
										{it.desc && <span class="cart__desc">{it.desc}</span>}
									</span>
									<span class="cart__qty" aria-hidden="true">1 ⌄</span>
								</li>
							))}
						</ul>
						<div class="cart__summary">
							<b>{L("cart_summary", "Resumen del pedido")}</b>
							<div class="cart__row"><span>{L("cart_subtotal", "Subtotal")}</span><b>{L("cart_subtotal_value", "5 años con Auchan")}</b></div>
							<div class="cart__row"><span>{L("cart_shipping", "Envío")}</span><span class="cart__free">{L("cart_shipping_value", "gratis")}</span></div>
							<div class="cart__row cart__row--total"><span>{L("cart_total", "Total")}</span><b>{L("cart_total_value", "un equipo")}</b></div>
							<a href={contactPath} class="btn cart__cta">{ctaLabel}</a>
							<span class="cart__returns">{L("cart_returns", "Devoluciones: no las vas a necesitar")}</span>
						</div>
					</div>
				</div>
			)}

			{kind === "terminal" && (
				<div class="inst inst--dark" role="group" aria-label={s.heading}>
					<div class="inst__bar inst__bar--dots" aria-hidden="true"><i></i><i></i><i></i></div>
					<div class="term">
						<p class="term__cmd"><span class="term__prompt">➜ {L("term_host", "serverstartup.io")}</span>{" "}{L("term_cmd_main", "integrar --erp --tienda --almacen")}</p>
						{s.items.map((it) => (
							<p class="term__line"><span class="term__ok" aria-hidden="true">✓</span>{" "}<span class="term__label">{it.label.toLowerCase()}</span>{it.desc && <span class="term__out">{" — "}{it.desc}</span>}</p>
						))}
						<p class="term__cmd"><span class="term__prompt">➜ {L("term_host", "serverstartup.io")}</span>{" "}{L("term_cmd_observe", "observar --extremo-a-extremo")}</p>
						{leadLines.map((line) => (
							<p class="term__pipe">│ {line}</p>
						))}
						<p class="term__log">╰─ {L("term_log", "INFO … Server startup in [2019] ms")}</p>
					</div>
				</div>
			)}

			{kind === "bigquery" && (
				<>
					{s.leadBlocks.length > 0 && (
						<div class="s-inst__intro s-inst__lead"><PortableText value={s.leadBlocks} components={{ mark: TightMark }} /></div>
					)}
					<div class="inst inst--light" role="group" aria-label={s.heading}>
						<div class="inst__bar bq__bar">
							<span class="bq__tab">{bqTab} <span class="inst__muted">✕</span></span>
							<span class="bq__run">▶ {bqRun}</span>
							<span class="bq__menu">{bqMenu}</span>
						</div>
						<div class="bq__editor">
							<div class="bq__gutter" aria-hidden="true">1<br />2<br />3<br />4<br />5</div>
							<pre class="bq__sql"><span class="bq__comment">{bqCTop}</span>
<span class="bq__kw">SELECT</span> {bqL1}
<span class="bq__kw">FROM</span> <span class="bq__table">{bqTable}</span>
<span class="bq__kw">WHERE</span> {bqL3}
<span class="bq__comment">{bqCBottom}</span></pre>
						</div>
						<div class="bq__results">
							<p class="bq__status">✓ {bqStatus}</p>
							<div class="bq__grid">
								<table>
									<thead><tr>{bqHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
									<tbody>
										{bqRows.map((r, i) => (
											<tr><td class="inst__muted">{i + 1}</td>{r.map((c) => <td>{c}</td>)}</tr>
										))}
									</tbody>
								</table>
							</div>
							<p class="bq__note">{bqNote}</p>
						</div>
					</div>
					{s.itemBlocks.length > 0 && (
						<div class="inst-list"><PortableText value={s.itemBlocks} components={{ mark: TightMark }} /></div>
					)}
				</>
			)}

			{kind === "dashboard" && (
				<div class="inst inst--light" role="group" aria-label={s.heading}>
					<div class="inst__bar">
						<svg width="26" height="17" viewBox="0 0 32 20" aria-hidden="true"><path d="M25 15a4.5 4.5 0 0 0 .3-9A7.5 7.5 0 0 0 11 4.6 6 6 0 0 0 6 15Z" fill="#F38020"/></svg>
						<b>{L("cf_title", "Seguridad · serverstartup.io")}</b>
						<span class="cf__status">{L("cf_status", "ACTIVO")}</span>
					</div>
					{cfTiles.length > 0 && (
						<div class="cf__tiles">
							{cfTiles.map(([label, value]) => (
								<div class="cf__tile"><span class="cf__tile-label">{label}</span><span class="cf__tile-value">{value}</span></div>
							))}
						</div>
					)}
					<div class="cf__toggles">
						{s.items.map((it) => (
							<div class="cf__toggle">
								<span class="cf__switch cf__switch--on" aria-hidden="true"><i></i></span>
								<span><b>{it.label}</b>{it.desc && <span class="cf__desc">{it.desc}</span>}</span>
							</div>
						))}
						<div class="cf__toggle">
							<span class="cf__switch" aria-hidden="true"><i></i></span>
							<span><b>{L("cf_joke_title", "Modo «lo montó alguien que ya no está»")}</b><span class="cf__desc">{L("cf_joke_desc", "Desactivado desde 2019. Las reglas las escribimos y las mantenemos nosotros.")}</span></span>
						</div>
					</div>
				</div>
			)}

			{kind === "javadoc" && (
				<div class="inst inst--dark inst--javadoc" role="group" aria-label={s.heading}>
					<div class="inst__bar inst__bar--file"><span class="inst__muted">{L("jd_file", "MotorDeNegocio.java — greenfield")}</span><span class="jd__ok">{L("jd_status", "Java 21 · 0 warnings")}</span></div>
					<div class="jd">
						<div class="jd__gutter" aria-hidden="true">{Array.from({ length: s.items.length + leadLines.length + 5 }, (_, i) => <span>{i + 1}</span>)}</div>
						<div class="jd__code">
							<p class="jd__doc">/**</p>
							{leadLines.map((line) => (
								<p class="jd__doc">&nbsp;* {line}</p>
							))}
							<p class="jd__doc">&nbsp;*</p>
							{s.items.map((it, i) => (
								<p class="jd__doc">&nbsp;* <span class="jd__tag">@param</span>{" "}<span class="jd__name">{jdTags[i] ?? `p${i + 1}`}</span>{" "}{it.label}. {it.desc}</p>
							))}
							<p class="jd__doc">&nbsp;* <span class="jd__tag">@author</span>{" "}{L("jd_author", "los mismos tres ingenieros, de principio a fin")}</p>
							<p class="jd__doc">&nbsp;* <span class="jd__tag">@since</span>{" "}{L("jd_since", "2019")}</p>
							<p class="jd__doc">&nbsp;*/</p>
							<p class="jd__sig">{jdSig}</p>
						</div>
					</div>
				</div>
			)}

			{(s.closerHeading || s.closer.length > 0) && (
				<div class="s-inst__closer">
					{s.closerHeading && <h2>{s.closerHeading}</h2>}
					<PortableText value={s.closer} components={closerComponents} />
				</div>
			)}
		</div>
	</section>
) : (
	<section class="s-content" aria-label={s.heading || "content"}>
		<div class="container s-content__inner">
			<PortableText value={mdNormalize(content)} components={{ mark: TightMark }} />
		</div>
	</section>
)}
