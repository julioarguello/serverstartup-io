---
/**
 * LanguageSwitcher — toggle between ES / EN.
 *
 * Shows the *other* locale as a link. The target URL is NOT computed here:
 * slugs are translated (/quienes-somos ↔ /en/about-us), so the switcher
 * renders the same `altPath` Base resolved for the hreflang tags (#291) —
 * one value, one source (utils/alternate). When no published counterpart
 * exists (altPath = null), fall back to the alternate locale's homepage.
 */
interface Props {
	altPath: string | null;
}
const { altPath } = Astro.props;

const currentLocale = Astro.currentLocale || "es";
const altLocale = currentLocale === "es" ? "en" : "es";
const altLabel = altLocale.toUpperCase();
const href = altPath ?? (altLocale === "en" ? "/en" : "/");

const t = Astro.locals.t;
---

<a
	href={href}
	class="lang-switch"
	aria-label={t("switch_language")}
	hreflang={altLocale}
>
	{altLabel}
</a>

<style>
	.lang-switch {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.25rem;
		height: 2.25rem;
		padding: 0 0.5rem;
		/* the bar's own switch (#413): ink and hairline on paper, paper and a
		   translucent hairline when the bar is sitting on the hero image */
		border: 1px solid var(--bar-rule, var(--color-border));
		border-radius: var(--radius);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--bar-ink, var(--color-text));
		background: transparent;
		text-decoration: none;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	@media (max-width: 480px) {
		.lang-switch {
			min-width: 2rem;
			height: 2rem;
			padding: 0 0.4rem;
			font-size: 0.7rem;
		}
	}

	.lang-switch:hover {
		background: var(--bar-ink, var(--color-primary));
		color: var(--bar-ink-invert, var(--color-secondary));
		border-color: var(--bar-ink, var(--color-primary));
	}
</style>
