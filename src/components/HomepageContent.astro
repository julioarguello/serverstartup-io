---
/**
 * HomepageContent — shared homepage layout component.
 *
 * Extracts the common homepage rendering logic used by both
 * index.astro (ES) and en/index.astro (EN).
 *
 * Content source: pages/home (EmDash CMS, locale-scoped)
 * PT sections split by h2 headings:
 *   - hero: blocks before first h2
 *   - "~ Tecnología..." / "~ Technology...": h2 + body
 *   - "~ Áreas..." / "~ Areas...": h2 + subtitle
 *
 * CTA block sourced from cta_global widget area.
 * Service cards derived from services collection.
 * Section 3 (Cloudflare Partner) driven by partners collection.
 */
import { getEmDashEntry, getEmDashCollection } from "emdash";
import CloudflarePartner from "./CloudflarePartner.astro";
import { PortableText } from "emdash/ui";
import CtaGlobal from "./CtaGlobal.astro";
import { getUiLabels } from "../utils/ui-labels";
const t = Astro.locals.t;

const locale = Astro.currentLocale || "es";
const localePrefix = locale === "es" ? "" : `/${locale}`;

const { entry, cacheHint } = await getEmDashEntry("pages", "home", { locale });
if (!entry) return Astro.redirect("/404");
Astro.cache.set(cacheHint);

const { title, content, excerpt } = entry.data;

// Fetch services collection for cards
const { entries: serviceEntries } = await getEmDashCollection("services", {
	orderBy: { created_at: "asc" },
	locale,
});
const services = serviceEntries ?? [];

const labels = await getUiLabels(locale);
const heroServicesBtn = labels.get("footer_headings", "hero_services_btn", locale === "en" ? "Our services" : "Nuestros servicios");

// Split PT content by h2 headings into named sections
type Section = { heading: string; blocks: any[] };
const sections: Section[] = [];
let currentSection: Section = { heading: "", blocks: [] };

for (const block of (content as any[]) || []) {
	if (block._type === "block" && block.style === "h2") {
		if (currentSection.heading || currentSection.blocks.length > 0) {
			sections.push(currentSection);
		}
		const headingText = block.children?.map((c: any) => c.text).join("") || "";
		currentSection = { heading: headingText, blocks: [] };
	} else {
		currentSection.blocks.push(block);
	}
}
if (currentSection.heading || currentSection.blocks.length > 0) {
	sections.push(currentSection);
}

// Named section extraction
const heroSection = sections[0]; // blocks before first h2
const techSection = sections.find((s) => s.heading.includes("Tecnología") || s.heading.includes("Technology"));
const areasSection = sections.find((s) => s.heading.includes("Áreas") || s.heading.includes("Areas"));

// Extract tech subtitle (first block with marks) and body (second block)
const techSubtitleBlock = techSection?.blocks[0];
const techBodyBlock = techSection?.blocks[1];

// Extract areas subtitle
const areasSubtitle = areasSection?.blocks[0]?.children?.map((c: any) => c.text).join("") || "";
---

<!-- ══════ SECTION 1: HERO ══════ -->
<section class="s-hero" aria-label={t("hero_intro")}>
	<div class="container s-hero__inner">
		<h1>{title}</h1>
		{heroSection?.blocks.length > 0 && (
			<div class="s-hero__kicker">
				<PortableText value={[heroSection.blocks[0]]} />
			</div>
		)}
		{heroSection?.blocks.length > 1 && (
			<div class="s-hero__body">
				<PortableText value={heroSection.blocks.slice(1)} />
			</div>
		)}
		<a href="#areas-especializacion" class="btn btn-dark">{heroServicesBtn}</a>
	</div>
</section>

<!-- ══════ SECTION 2: TECNOLOGÍA / TECHNOLOGY ══════ -->
{techSection && (
	<section class="s-tech" aria-label={techSection.heading}>
		<div class="container s-tech__inner">
			<div class="s-tech__col-left">
				<h2>{techSection.heading}</h2>
			</div>
			<div class="s-tech__col-right">
				{techSubtitleBlock && (
					<div class="s-tech__subtitle-wrap">
						<PortableText value={[techSubtitleBlock]} />
					</div>
				)}
				{techBodyBlock && (
					<div class="s-tech__body-wrap">
						<PortableText value={[techBodyBlock]} />
					</div>
				)}
			</div>
		</div>
	</section>
)}

<!-- ══════ SECTION 3: CLOUDFLARE PARTNER (CMS-driven) ══════ -->
<CloudflarePartner />

<!-- ══════ SECTION 4: ÁREAS DE ESPECIALIZACIÓN (CMS-driven) ══════ -->
<section class="s-areas" id="areas-especializacion" aria-label={areasSection?.heading || labels.get("footer_headings", "services_title", "Áreas de especialización")}>
	<div class="container s-areas__inner">
		<!-- Left: sticky header -->
		<div class="s-areas__header">
			<h2>{areasSection?.heading || `~ ${labels.get("footer_headings", "services_title", "Áreas de especialización")}`}</h2>
			<p class="text-sub">{areasSubtitle}</p>
		</div>

		<!-- Right: stacking cards from services collection -->
		<div class="s-areas__cards" role="list">
			{services.map((svc, i) => {
				const d = svc.data;
				const cardColor = d.color || '#BFEDEE';
				// YIQ luminance: dark brand backgrounds get white text (+ the CSS
				// overlay in .area-card--dark that lifts contrast to AA for body copy)
				const hex = cardColor.replace('#', '');
				const yiq = (parseInt(hex.substring(0, 2), 16) * 299 + parseInt(hex.substring(2, 4), 16) * 587 + parseInt(hex.substring(4, 6), 16) * 114) / 1000;
				const darkCard = yiq < 150;
				return (
					<article class={`area-card card${i + 1}${darkCard ? ' area-card--dark' : ''}`} style={`background-color: ${cardColor};`} role="listitem">
						<h3>{d.title}</h3>
						<p class="text-body">{d.excerpt}</p>
						<a href={`${localePrefix}/${svc.id}`} class="area-card__arrow" aria-label={t("view_service", { title: d.title })}>
							<svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</a>
					</article>
				);
			})}
		</div>
	</div>
</section>

<!-- ══════ SECTION 5: CTA (from cta_global widget) ══════ -->
<CtaGlobal />
