---
/**
 * CloudflarePartner — renders the featured partner card section.
 *
 * Fetches the first partner entry with Portable Text content and renders:
 * - Partner logo from featured_image
 * - h3 heading + description from PT blocks
 * - Feature list (h4 + p pairs) from PT blocks
 * - CTA button from cta_label field, linking to partner slug
 */
import { getEmDashCollection } from "emdash";
import { PortableText } from "emdash/ui";
import PtLink from "./PtLink.astro";
const t = Astro.locals.t;
const ptComponents = { mark: { link: PtLink } };

const locale = Astro.currentLocale || "es";

// Scoped to the locale (#306). Without this the query returned whatever came
// first — the ES entry — and the English homepage rendered the whole partner
// block in Spanish. If a locale has no entry the section renders NOTHING:
// falling back to another language is the behaviour this issue was filed for,
// and a missing block is honest where a foreign-language block is not.
const { entries: allPartners } = await getEmDashCollection("partners", {
	orderBy: { created_at: "asc" },
	locale,
});

// The "featured" partner with full content = Cloudflare card
const featuredPartner = (allPartners ?? []).find(
	(p) => p.data.content && p.data.content.length > 0
);

if (!featuredPartner) return;

const d = featuredPartner.data;
const logo = d.featured_image;
const ctaLabel = d.cta_label;
const localePrefix = locale === "es" ? "" : `/${locale}`;
// The block introduces the partnership; the button sends you where that
// partnership is actually work — the edge vertical — not to the partner's own
// page, which repeats what you just read (founder, 2026-08-19).
const edgeSlug = locale === "en" ? "cdn-waf-edge-security-cloudflare" : "cdn-waf-seguridad-edge-cloudflare";
const ctaHref = `${localePrefix}/${edgeSlug}`;

// Parse PT blocks into heading, description, and features
const blocks = d.content || [];
const h3Block = blocks.find((b: any) => b.style === "h3");
const heading = h3Block?.children?.[0]?.text || d.title;

// First normal block = description. Kept as a BLOCK, not as a string: reading
// `children[0].text` silently dropped every link the CMS put in it, which is
// why "Cloudflare" was the one mention on the home with nothing behind it
// (founder, 2026-08-19).
const normalBlocks = blocks.filter((b: any) => b.style === "normal");
const descriptionBlock = normalBlocks[0];

// h4 + normal pairs = features
const h4Blocks = blocks.filter((b: any) => b.style === "h4");
const features = h4Blocks.map((h4: any, i: number) => ({
	title: h4.children?.[0]?.text || "",
	desc: ((normalBlocks[i + 1]?.children as any[]) ?? []).map((c: any) => c.text).join("") || "",
}));
---

<section class="s-cf" aria-label={t("cf_partner")}>
	<div class="container s-cf__wrapper">
		<article class="s-cf__card">
			{logo && (
				<img
					src={logo.src}
					alt={logo.alt || d.title}
					width="268"
					class="s-cf__logo"
					loading="lazy"
				/>
			)}
			<h3>{heading}</h3>
			{descriptionBlock && (
				<div class="text-body s-cf__desc">
					<PortableText value={[descriptionBlock]} components={ptComponents} />
				</div>
			)}

			{features.length > 0 && (
				<ul class="s-cf__features" role="list">
					{features.map((f: { title: string; desc: string }) => (
						<li class="s-cf__feature">
							<h4>{f.title}</h4>
							<p class="text-body">{f.desc}</p>
						</li>
					))}
				</ul>
			)}

			{ctaLabel && (
				<a href={ctaHref} class="btn btn-dark">{ctaLabel}</a>
			)}
		</article>
	</div>
</section>
