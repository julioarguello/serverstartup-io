---
import ReferenceBanner from "./ReferenceBanner.astro";
/**
 * SiteFooter — trust logos, 4-column grid, Kit Digital banner.
 * Extracted from Base.astro for maintainability.
 */
interface ServiceEntry {
	slug?: string;
	id: string;
	data: { title: string };
}

interface Props {
	trustTitle: string;
	servicesTitle: string;
	partnersTitle: string;
	contactTitle: string;
	aboutUsLabel: string;
	manualLabel: string;
	defaultCtaLabel: string;
	email: string;
	phone: string;
	phoneDisplay: string;
	partnerLogos: { src: string; alt: string }[];
	services: ServiceEntry[];
	localePrefix: string;
	locale: string;
}

const {
	trustTitle,
	servicesTitle,
	partnersTitle,
	contactTitle,
	aboutUsLabel,
	manualLabel,
	defaultCtaLabel,
	email,
	phone,
	phoneDisplay,
	partnerLogos,
	services,
	localePrefix,
	locale,
} = Astro.props;
const t = Astro.locals.t;
---

<footer class="site-footer">
	<!-- Citable references (#296): one static band, every content page.
	     Replaces the old strip, which read `partners` where five duplicate
	     Cloudflare placeholders lived — the same logo, five times, sitewide. -->
	<ReferenceBanner
		title={trustTitle}
		href={`${localePrefix}/${locale === "en" ? "references" : "referencias"}`}
		ariaLabel={t("trust_section")}
	/>

	<!-- 4-column footer grid -->
	<div class="footer-main">
		<div class="container footer-grid">
			<!-- Col 1: Logo -->
			<div class="footer-col">
				<a href="/" aria-label={t("go_home")}>
					<img
						src="/assets/logo-vertical.png"
						alt="Server Startup"
						class="footer-logo-img"
						width="250"
						loading="lazy"
					/>
				</a>
			</div>

			<!-- Col 2: Services -->
			<div class="footer-col">
				<h3>{servicesTitle}</h3>
				<ul class="footer-list">
					{services.map((svc) => (
						<li><a href={`${localePrefix}/${svc.slug ?? svc.id}`}>{svc.data.title}</a></li>
					))}
				</ul>
			</div>

			<!-- Col 3: Partner -->
			<div class="footer-col">
				<h3>{partnersTitle}</h3>
				{partnerLogos.length > 0 ? (
					partnerLogos.map((logo) => (
						<img
							src={logo.src}
							alt={logo.alt}
							class="footer-partner-logo"
							loading="lazy"
						/>
					))
				) : (
					<img
						src="/assets/logo-cloudflare.svg"
						alt={t("cf_partner")}
						class="footer-partner-logo"
						loading="lazy"
					/>
				)}
			</div>

			<!-- Col 4: Contact -->
			<div class="footer-col">
				<h3>{contactTitle}</h3>
				<ul class="footer-list">
					<li><a href={`${localePrefix}/${locale === "en" ? "about-us" : "quienes-somos"}`}>{aboutUsLabel}</a></li>
					<li><a href={`${localePrefix}/${locale === "en" ? "deconstructing" : "deconstruyendo"}`}>{manualLabel}</a></li>
					<li><a href={`mailto:${email}`}>{email}</a></li>
					{phone && phoneDisplay && <li><a href={`tel:${phone}`}>{phoneDisplay}</a></li>}
				</ul>
				<a href={`${localePrefix}/${locale === "en" ? "contact" : "contacto"}`} class="btn btn-dark footer-cta">{defaultCtaLabel}</a>
			</div>
		</div>
	</div>

	<!-- Kit Digital banner -->
	<div class="footer-banner">
		<img
			src="/assets/kit-digital-banner.jpg"
			alt={t("kit_digital")}
			class="footer-banner-img"
			loading="lazy"
		/>
	</div>
</footer>

<style is:global>
	/* ═══════════════════════════════════════════
	   FOOTER — mobile-first
	   ═══════════════════════════════════════════ */
	.site-footer {
		background: var(--color-secondary);
	}

	/* Trust logos */
	.trust-logo {
		height: 60px;
		width: auto;
		object-fit: contain;
	}
	@media (min-width: 768px) {
		.trust-logos { gap: 40px; }
		.trust-logo { height: 100px; }
	}

	/* Footer grid */
	.footer-main {
		border-top: 1px solid rgba(30, 30, 30, 0.48);
		border-bottom: 1px solid rgba(30, 30, 30, 0.48);
		margin-top: 48px;
		padding: 40px 0;
	}
	.footer-grid {
		display: flex;
		flex-direction: column;
		gap: 32px;
		/* stacked mobile footer reads centered — logo, columns and partner
		   marks alike (the desktop row overrides below) */
		align-items: center;
		text-align: center;
	}
	.footer-col h3 {
		margin-bottom: 16px;
		/* h3 for document outline; visual size stays as the old h5 */
		font-size: 20px;
		line-height: 26px;
	}
	.footer-logo-img {
		width: 180px;
		height: auto;
	}
	.footer-list {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.footer-list,
	.footer-list a {
		font-family: var(--font-family);
		font-size: 18px;
		font-weight: 300;
		line-height: 26px;
		color: var(--color-primary);
	}
	.footer-partner-logo {
		max-width: 200px;
		margin-top: 8px;
		margin-inline: auto;
	}
	.footer-cta {
		margin-top: 32px;
	}

	@media (min-width: 768px) {
		.footer-grid {
			flex-direction: row;
			gap: 40px;
			align-items: flex-start;
			text-align: left;
		}
		.footer-partner-logo { margin-inline: 0; }
		.footer-col {
			flex: 1;
		}
		.footer-logo-img { width: 250px; }
	}

	/* Kit Digital banner */
	.footer-banner {
		padding: 0;
		margin: 0;
	}
	.footer-banner-img {
		width: 100%;
		display: block;
	}
</style>
