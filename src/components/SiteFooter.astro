---
/**
 * SiteFooter — trust logos, 4-column grid, Kit Digital banner.
 * Extracted from Base.astro for maintainability.
 */
interface TrustLogo {
	src: string;
	alt: string;
}

interface ServiceEntry {
	id: string;
	data: { title: string };
}

interface Props {
	trustTitle: string;
	servicesTitle: string;
	partnersTitle: string;
	contactTitle: string;
	aboutUsLabel: string;
	manualLabel: string;
	defaultCtaLabel: string;
	email: string;
	phone: string;
	phoneDisplay: string;
	trustLogos: TrustLogo[];
	services: ServiceEntry[];
	localePrefix: string;
	locale: string;
}

const {
	trustTitle,
	servicesTitle,
	partnersTitle,
	contactTitle,
	aboutUsLabel,
	manualLabel,
	defaultCtaLabel,
	email,
	phone,
	phoneDisplay,
	trustLogos,
	services,
	localePrefix,
	locale,
} = Astro.props;
const t = Astro.locals.t;
---

<footer class="site-footer">
	<!-- Trust logos carousel -->
	<section class="footer-trust" aria-label={t("trust_section")}>
		<div class="container">
			<h2 class="footer-trust__title">{trustTitle}</h2>
			<ul class="trust-logos" role="list" aria-label={t("trust_logos")}>
				{trustLogos.map((logo) => (
					<li>
						<img src={logo.src} alt={logo.alt} class="trust-logo" loading="lazy" />
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- 4-column footer grid -->
	<div class="footer-main">
		<div class="container footer-grid">
			<!-- Col 1: Logo -->
			<div class="footer-col">
				<a href="/" aria-label={t("go_home")}>
					<img
						src="/assets/logo-vertical.png"
						alt="Server Startup"
						class="footer-logo-img"
						width="250"
						loading="lazy"
					/>
				</a>
			</div>

			<!-- Col 2: Services -->
			<div class="footer-col">
				<h3>{servicesTitle}</h3>
				<ul class="footer-list">
					{services.map((svc) => (
						<li><a href={`${localePrefix}/${svc.id}`}>{svc.data.title}</a></li>
					))}
				</ul>
			</div>

			<!-- Col 3: Partner -->
			<div class="footer-col">
				<h3>{partnersTitle}</h3>
				{trustLogos.length > 0 ? (
					trustLogos.map((logo) => (
						<img
							src={logo.src}
							alt={logo.alt}
							class="footer-partner-logo"
							loading="lazy"
						/>
					))
				) : (
					<img
						src="/assets/logo-cloudflare.svg"
						alt="Cloudflare Partner"
						class="footer-partner-logo"
						loading="lazy"
					/>
				)}
			</div>

			<!-- Col 4: Contact -->
			<div class="footer-col">
				<h3>{contactTitle}</h3>
				<ul class="footer-list">
					<li><a href={`${localePrefix}/${locale === "en" ? "about-us" : "quienes-somos"}`}>{aboutUsLabel}</a></li>
					<li><a href={`${localePrefix}/${locale === "en" ? "deconstructing" : "deconstruyendo"}`}>{manualLabel}</a></li>
					<li><a href={`mailto:${email}`}>{email}</a></li>
					{phone && phoneDisplay && <li><a href={`tel:${phone}`}>{phoneDisplay}</a></li>}
				</ul>
				<a href={`${localePrefix}/${locale === "en" ? "contact" : "contacto"}`} class="btn btn-dark footer-cta">{defaultCtaLabel}</a>
			</div>
		</div>
	</div>

	<!-- Kit Digital banner -->
	<div class="footer-banner">
		<img
			src="/assets/kit-digital-banner.jpg"
			alt="Programa Kit Digital — Financiado por los fondos Next Generation de la Unión Europea"
			class="footer-banner-img"
			loading="lazy"
		/>
	</div>
</footer>

<style is:global>
	/* ═══════════════════════════════════════════
	   FOOTER — mobile-first
	   ═══════════════════════════════════════════ */
	.site-footer {
		background: var(--color-secondary);
	}

	/* Trust logos */
	.footer-trust {
		text-align: center;
		padding: 48px 0 0;
	}
	.footer-trust__title {
		margin-bottom: 24px;
		font-style: italic;
		/* h2 for document outline; visual size stays as the old h4 */
		font-size: 22px;
		line-height: 30px;
		font-weight: 400;
	}
	.trust-logos {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}
	.trust-logo {
		height: 60px;
		width: auto;
		object-fit: contain;
	}
	@media (min-width: 768px) {
		.trust-logos { gap: 40px; }
		.trust-logo { height: 100px; }
	}

	/* Footer grid */
	.footer-main {
		border-top: 1px solid rgba(30, 30, 30, 0.48);
		border-bottom: 1px solid rgba(30, 30, 30, 0.48);
		margin-top: 48px;
		padding: 40px 0;
	}
	.footer-grid {
		display: flex;
		flex-direction: column;
		gap: 32px;
		align-items: flex-start;
	}
	.footer-col h3 {
		margin-bottom: 16px;
		/* h3 for document outline; visual size stays as the old h5 */
		font-size: 20px;
		line-height: 26px;
	}
	.footer-logo-img {
		width: 180px;
		height: auto;
	}
	.footer-list {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.footer-list,
	.footer-list a {
		font-family: var(--font-family);
		font-size: 18px;
		font-weight: 300;
		line-height: 26px;
		color: var(--color-primary);
	}
	.footer-partner-logo {
		max-width: 200px;
		margin-top: 8px;
	}
	.footer-cta {
		margin-top: 32px;
	}

	@media (min-width: 768px) {
		.footer-grid {
			flex-direction: row;
			gap: 40px;
		}
		.footer-col {
			flex: 1;
		}
		.footer-logo-img { width: 250px; }
	}

	/* Kit Digital banner */
	.footer-banner {
		padding: 0;
		margin: 0;
	}
	.footer-banner-img {
		width: 100%;
		display: block;
	}
</style>
