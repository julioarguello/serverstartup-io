---
/**
 * Portable Text link mark — single-line template.
 *
 * EmDash's built-in Link.astro puts <slot /> on its own indented line, which
 * compiles to whitespace text nodes INSIDE the anchor. That trailing space
 * lets the line break before following punctuation (", el" orphaned at line
 * start). Keeping the whole anchor on one line removes the stray spaces.
 */
export interface Props {
	node: {
		markDef: {
			_type: "link";
			_key: string;
			href: string;
			blank?: boolean;
		};
	};
}

const { node } = Astro.props;
const href = node?.markDef?.href;
const blank = node?.markDef?.blank;
---
<a href={href} target={blank ? "_blank" : undefined} rel={blank ? "noopener noreferrer" : undefined}><slot /></a>
