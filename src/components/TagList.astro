---
interface Props {
  tags: Array<{ slug: string; label: string }>;
  class?: string;
  locale?: string;
}

const { tags, class: className, locale = "es" } = Astro.props;
---

{tags.length > 0 && (
  <ul class:list={["tag-list", className]}>
    {tags.map((tag) => (
      <li>
        <a href={`${locale === "en" ? "/en" : ""}/tag/${tag.slug}`} class="tag">{tag.label}</a>
      </li>
    ))}
  </ul>
)}

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag {
    display: inline-block;
    padding: 4px 12px;
    font-size: 14px;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border-radius: var(--radius);
    text-decoration: none;
    transition: color 0.2s, background 0.2s;
  }

  .tag:hover {
    color: var(--color-text);
    background: var(--color-surface-hover);
  }
</style>
