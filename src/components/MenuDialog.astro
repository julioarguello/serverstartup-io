---
/**
 * MenuDialog — list + living logo (#211 v29, #231; supersedes the sheet).
 *
 * A traditional menu that drives the die: specialties in large type with
 * colored 2×2 mini-face bullets, one quiet line of site links below, and
 * the logo-as-die on the right reacting to every hover/focus. Labels and
 * colors come from the CMS; the die is decorative (aria-hidden).
 *
 * Dialog contract (ids, open/close classes) is unchanged — Base's script
 * keeps driving it.
 */
import LogoDie from "./LogoDie.astro";
import { FACE_BY_SLUG, FACE_ORDER, SITE_BY_PATH } from "../utils/nav";

interface ServiceEntry {
	id: string;
	slug?: string;
	data: { title?: string; color?: string };
}
interface MenuItem {
	url?: string;
	label?: string;
}
interface Props {
	services: ServiceEntry[];
	siteItems: MenuItem[];
	currentPath: string;
	localePrefix: string;
}
const { services, siteItems, currentPath, localePrefix } = Astro.props;
const t = Astro.locals.t;

const activeFace = FACE_BY_SLUG[currentPath.replace(/^\/en/, "").replace(/^\//, "")] ?? null;
const activeSite = SITE_BY_PATH[currentPath] ?? null;

const specLinks = services
	.map((s) => {
		const slug = s.slug ?? s.id;
		return {
			key: FACE_BY_SLUG[slug],
			href: `${localePrefix}/${slug}`,
			title: s.data.title ?? slug,
			color: s.data.color ?? "#1E1E1E",
		};
	})
	.filter((l) => l.key)
	.sort((a, b) => FACE_ORDER.indexOf(a.key) - FACE_ORDER.indexOf(b.key));

const siteLinks = siteItems
	.map((it) => ({
		key: SITE_BY_PATH[it.url ?? ""],
		href: it.url ?? "#",
		title: it.label ?? "",
	}))
	.filter((l) => l.key);
---

<div class="menu-backdrop" id="menu-backdrop" aria-hidden="true"></div>
<dialog class="menu-dialog" id="menu-dialog" aria-label={t("main_menu")}>
	<button
		type="button"
		class="menu-close"
		id="menu-close"
		aria-label={t("close_menu")}
	>✕</button>

	<div class="menu-inner">
		<div class="menu-lists">
			<nav aria-label={t("nav_specialties")}>
				<ul class="menu-spec" role="list">
					{specLinks.map((l) => (
						<li>
							<a
								href={l.href}
								class="spec-link"
								style={`--fc:${l.color}`}
								data-die-spec={l.key}
								aria-current={l.key === activeFace ? "page" : undefined}
							>
								<span class="spec-mini" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
								<span class="spec-title">{l.title}</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
			<nav aria-label={t("nav_site")}>
				<ul class="menu-site" role="list">
					{siteLinks.map((l) => (
						<li>
							<a
								href={l.href}
								class="site-link"
								data-die-site={l.key}
								aria-current={l.key === activeSite ? "page" : undefined}
							>{l.title}</a>
						</li>
					))}
				</ul>
			</nav>
		</div>
		<div class="menu-die">
			<LogoDie services={services} currentPath={currentPath} />
			<p class="die-hint" aria-hidden="true">{t("die_hint")}</p>
		</div>
	</div>
</dialog>

<style is:global>
	/* ═══════════════════════════════════════════
	   MENU DIALOG — list + living logo
	   ═══════════════════════════════════════════ */
	.menu-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.3);
		z-index: 199;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.5s;
	}
	.menu-backdrop.is-open { opacity: 1; pointer-events: auto; }

	.menu-dialog {
		position: fixed;
		top: 0;
		right: 0;
		width: 100vw;
		height: 100vh;
		max-width: 100vw;
		max-height: 100vh;
		background: var(--color-secondary);
		border: none;
		z-index: 200;
		transform: translateX(100%);
		transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		overflow-y: auto;
		padding: 0;
		margin: 0;
	}
	.menu-dialog::backdrop { background: transparent; }
	.menu-dialog.is-open { transform: translateX(0); }

	.menu-close {
		position: fixed;
		top: 32px;
		right: 32px;
		z-index: 201;
		background: none;
		border: none;
		font-size: 32px;
		cursor: pointer;
		color: var(--color-primary);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.menu-inner {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 96px 24px 48px;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 48px;
		align-items: center;
		min-height: 100vh;
	}

	.menu-spec {
		display: flex;
		flex-direction: column;
		gap: 4px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.spec-link {
		display: flex;
		align-items: center;
		gap: 14px;
		font-size: 32px;
		font-weight: 650;
		line-height: 1.25;
		color: var(--color-primary);
		text-decoration: none;
		padding: 8px 10px;
		transition: background 0.15s;
	}
	.spec-link:hover,
	.spec-link:focus-visible {
		background: color-mix(in srgb, var(--fc) 10%, white);
	}
	.spec-link[aria-current="page"] {
		background: color-mix(in srgb, var(--fc) 14%, white);
	}
	.spec-mini {
		display: inline-grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: 1fr 1fr;
		gap: 2px;
		width: 26px;
		height: 26px;
		border: 2px solid var(--fc);
		padding: 2px;
		flex: none;
	}
	.spec-mini i {
		background: var(--fc);
		opacity: 0.16;
	}
	.spec-link[aria-current="page"] .spec-mini i { opacity: 1; }

	.menu-site {
		margin: 22px 0 0;
		padding: 16px 10px 0;
		border-top: 1px dashed #e4e2de;
		display: flex;
		flex-wrap: nowrap;
		gap: 20px;
		list-style: none;
		overflow-x: auto;
		white-space: nowrap;
	}
	.site-link {
		font-size: 16px;
		font-weight: 500;
		color: rgba(30, 30, 30, 0.65);
		text-decoration: none;
		flex: none;
	}
	.site-link:hover,
	.site-link:focus-visible,
	.site-link[aria-current="page"] {
		color: var(--color-primary);
	}

	/* The grid item must be allowed to shrink below its content's automatic
	   minimum — the nowrap site row otherwise inflates the 1fr track past
	   the viewport and the whole menu clips (#236). */
	.menu-lists {
		min-width: 0;
	}

	.menu-die {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.die-hint {
		display: none;
		font-family: var(--font-mono), monospace;
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: lowercase;
		color: rgba(30, 30, 30, 0.55);
		margin: 0;
		text-align: center;
	}

	/* The die highlights the specialty it lands on when rolled by tap */
	.spec-link.rolled {
		background: color-mix(in srgb, var(--fc) 10%, white);
	}

	/* tablet: the approved composition, compressed — die at ×0.85 with air */
	@media (min-width: 701px) and (max-width: 1100px) {
		.menu-inner {
			gap: 28px;
			padding-inline: 40px;
		}
		.logo-stage { transform: scale(0.85); margin: -14px 0; }
		.menu-die { padding-right: 6px; }
		.die-hint { display: block; }
	}

	/* mobile: the die opens the menu — compass position, tap to roll */
	@media (max-width: 700px) {
		.menu-inner {
			grid-template-columns: 1fr;
			gap: 20px;
			padding: 76px 16px 40px;
			align-content: start;
		}
		.menu-die { order: -1; }
		.logo-stage { transform: scale(0.62); margin: -38px 0; }
		.die-hint { display: block; }
		.spec-link { font-size: 26px; }
	}
</style>
