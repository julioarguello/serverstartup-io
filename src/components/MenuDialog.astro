---
/**
 * MenuDialog — fullscreen slide-in navigation from right.
 * Extracted from Base.astro for maintainability.
 */
interface MenuItem {
	url?: string;
	label?: string;
}

interface Props {
	serviceItems: MenuItem[];
	secondaryItems: MenuItem[];
}

const { serviceItems, secondaryItems } = Astro.props;
const t = Astro.locals.t;
---

<div class="menu-backdrop" id="menu-backdrop" aria-hidden="true"></div>
<dialog
	class="menu-dialog"
	id="menu-dialog"
	aria-label={t("main_menu")}
>
	<button
		type="button"
		class="menu-close"
		id="menu-close"
		aria-label={t("close_menu")}
	>✕</button>
	<nav aria-label={t("main_nav")}>
		<ul class="menu-list" role="list">
			{serviceItems.map((item) => (
				<li><a href={item.url} class="menu-link">{item.label}</a></li>
			))}
			{secondaryItems.map((item) => (
				<li><a href={item.url} class="menu-link menu-link--secondary">{item.label}</a></li>
			))}
		</ul>
	</nav>
</dialog>

<style is:global>
	/* ═══════════════════════════════════════════
	   MENU DIALOG — fullscreen slide-in from right
	   ═══════════════════════════════════════════ */
	.menu-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.3);
		z-index: 199;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.5s;
	}
	.menu-backdrop.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	.menu-dialog {
		position: fixed;
		top: 0;
		right: 0;
		width: 100vw;
		height: 100vh;
		max-width: 100vw;
		max-height: 100vh;
		background: var(--color-secondary);
		border: none;
		z-index: 200;
		transform: translateX(100%);
		transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		overflow-y: auto;
		padding: 0;
		margin: 0;
	}
	.menu-dialog::backdrop {
		background: transparent;
	}
	.menu-dialog.is-open {
		transform: translateX(0);
	}

	.menu-close {
		position: fixed;
		top: 32px;
		right: 32px;
		z-index: 201;
		background: none;
		border: none;
		font-size: 32px;
		cursor: pointer;
		color: var(--color-primary);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.menu-list {
		padding: 80px 16px 40px;
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.menu-link {
		font-family: var(--font-family);
		font-size: 32px;
		font-weight: 600;
		line-height: 40px;
		color: var(--color-primary);
		text-decoration: none;
		display: block;
		transition: color 0.3s;
	}
	.menu-link:hover {
		color: rgba(30, 30, 30, 0.75);
	}
	.menu-list .menu-link--secondary {
		font-size: 22px;
		line-height: 30px;
	}

	@media (min-width: 768px) {
		.menu-list { padding: 80px 20px 40px; max-width: var(--container-max); margin: 0 auto; }
		.menu-link { font-size: 48px; line-height: 54px; }
		.menu-list .menu-link--secondary { font-size: 32px; line-height: 40px; }
		.menu-close { right: 56px; }
	}
</style>
