---
/**
 * SiteHeader — the wayfinding compass (#213, design #211 v7).
 *
 * Three pieces in one bar: the 2×2 logo cube (always ink — the mark never
 * mutates) as the menu trigger, the wordmark extended into a terminal-prompt
 * breadcrumb (~Server Startup/<path>▮ with the path in the section color),
 * and a 3px bottom edge carrying the same color. The accent comes from the
 * CMS service entry (via Base) — ink on site pages.
 */
import LanguageSwitcher from "./LanguageSwitcher.astro";
import SearchPrompt from "./SearchPrompt.astro";

interface Props {
	promptPath: string; // current pathname ("" on home)
	accent: string; // section color from CMS, ink for site pages
	altPath: string | null; // alternate-locale path resolved by Base (#291)
	/**
	 * The page opens with a dark image band under the bar (#413). The bar then
	 * has no ground of its own — paper ink straight on the picture — until
	 * there IS something under it: on scroll, and when the search opens,
	 * because that console is light by design and a light strip hanging off a
	 * transparent bar cuts the image in two.
	 */
	overHero?: boolean;
	/**
	 * The six vertical colours, in canonical order, when the band under the
	 * bar rotates through them (the home). The edge rides the SAME clock as
	 * the plates — one `--hero-cycle`, so the two cannot drift.
	 */
	slideColors?: string[];
}
const { promptPath, accent, altPath, overHero = false, slideColors = [] } = Astro.props;

// The edge's six stops, as custom properties the keyframes read. They come
// from the CMS service entries (Base sorts them by face), never from a copy
// of the palette in CSS: two lists of the same six colours are two lists that
// will eventually disagree.
const slideVars = slideColors.map((c, i) => `--c${i + 1}:${c}`).join(";");

// The brand prompt is the way back home — locale-aware, or EN visitors
// land on the Spanish home (#273)
const homeHref = (Astro.currentLocale || "es") === "en" ? "/en" : "/";

const t = Astro.locals.t;

// V2 (#216): the mark never changes shape and the strokes stay ink — but on
// section pages the 2×2 cells take the section color (the same language as
// the menu's mini-dice). Ink pages keep the plate greys. Base sends the
// literal ink fallback for non-section pages.
const isSection = accent !== "#1E1E1E";
const cellA = isSection ? `color-mix(in srgb, ${accent} 30%, white)` : "#CED4DA";
const cellB = isSection ? `color-mix(in srgb, ${accent} 18%, white)` : "#E3E7EB";
---

<header
	class:list={["site-header", overHero && "is-over-hero", slideColors.length > 0 && "is-rotating"]}
	id="site-header"
	style={`--accent:${accent};--cell-a:${cellA};--cell-b:${cellB}${slideVars ? ";" + slideVars : ""}`}
>
	<div class="container header-inner">
		<div class="header-brand">
			<button
				type="button"
				class="menu-toggle"
				id="menu-trigger"
				aria-expanded="false"
				aria-controls="menu-dialog"
				aria-label={t("open_menu")}
			>
				<svg class="brand-cube" width="30" height="34" viewBox="0 0 200 228" aria-hidden="true">
					<polygon class="brand-cube-cell" points="100,14 186,64 100,114 14,64"></polygon>
					<polygon class="brand-cube-cell" points="14,64 100,114 100,214 14,164"></polygon>
					<polygon class="brand-cube-cell brand-cube-cell--b" points="100,114 186,64 186,164 100,214"></polygon>
					<path class="brand-cube-edge" d="M100,14 186,64 186,164 100,214 14,164 14,64 Z"></path>
					<path class="brand-cube-edge" d="M14,64 100,114 186,64 M100,114 100,214"></path>
					<path class="brand-cube-edge" d="M57,39 143,89 M143,39 57,89"></path>
					<path class="brand-cube-edge" d="M57,89 57,189 M14,114 100,164 M143,89 143,189 M100,164 186,114"></path>
				</svg>
			</button>
			<a href={homeHref} class="brand-prompt">
				<span class="brand-word">~Server Startup</span><span class="brand-path">{promptPath}</span><span class="brand-cursor" aria-hidden="true"></span>
			</a>
		</div>
		<div class="header-actions">
			{/* The toggle lives with the other controls so it never moves — and
			    it is a REAL control: focusable and announced. It shipped with
			    `tabindex="-1" aria-hidden="true"` in #338, which made the
			    search reachable by mouse or by the `/` shortcut and by nothing
			    else. Tabbing the deployed page found three stops in the header
			    and none of them was this one (WCAG 2.1.1). */}
			<input
				type="checkbox"
				id="search-toggle"
				class="search-toggle"
				aria-label={t("search_open")}
			/>
			{/* No aria-hidden here: the W3C validator rejects it on a label bound
				    to a labelable control, and rightly — hiding the label breaks the
				    association it exists to make. Nothing is announced twice anyway:
				    the label holds only an aria-hidden icon, and the input carries
				    its own aria-label, which wins the name computation. */}
			<label for="search-toggle" class="search-btn">
				<svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<circle cx="8.5" cy="8.5" r="5.5"></circle>
					<path d="M13 13l4.5 4.5"></path>
				</svg>
			</label>
			<LanguageSwitcher altPath={altPath} />
		</div>
	</div>
	<SearchPrompt pathname={Astro.url.pathname} accent={accent} />
</header>

<style is:global>
	/* ═══════════════════════════════════════════
	   HEADER — the compass (mobile-first)
	   ═══════════════════════════════════════════ */
	.site-header {
		/* clip, not hidden: transient pre-font overflow must neither widen
		   the document (sticky mobile viewport expansion) nor create a
		   scroll container */
		overflow-x: clip;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		/* One switch for the whole bar (#413). Every piece below draws from
		   these three, so the transparent state over a dark hero is a change
		   of THREE values and not a second copy of the header's styling. */
		--bar-bg: var(--color-secondary);
		--bar-ink: var(--color-primary);
		--bar-ink-soft: var(--color-text-muted);
		--bar-ink-invert: var(--color-secondary);
		--bar-rule: var(--color-border);
		--bar-surface: var(--color-surface);
		background-color: var(--bar-bg);
		border-bottom: 3px solid var(--accent, var(--color-primary));
		transition: background-color 0.3s, box-shadow 0.3s;
	}

	.site-header.is-sticky {
		box-shadow: var(--shadow-card);
	}

	/* ═══════════════════════════════════════════
	   OVER THE HERO (#413)
	   The home — and each vertical page that opens with its plate — starts
	   with a dark image under the bar. The bar then has no ground of its
	   own: paper ink straight on the picture.

	   It goes back to being the ordinary white bar the moment there is
	   something under it, and there are exactly two such moments:

	     · `.is-sticky` — the page scrolled, which the existing listener
	       already tracks. One mechanism, not a second one.
	     · the search is open. That console is a LIGHT one by design (see
	       the SEARCH block below: "a dark strip under a white bar was a
	       hole in the page"), so opening it under a transparent bar would
	       cut the image with a light strip — the same hole, reversed.
	   ═══════════════════════════════════════════ */
	.site-header.is-over-hero:not(.is-sticky):not(:has(.search-toggle:checked)) {
		--bar-bg: transparent;
		--bar-ink: var(--color-secondary);
		--bar-ink-soft: var(--color-hero-ink-soft);
		--bar-ink-invert: var(--color-primary);
		--bar-rule: var(--color-hero-rule);
		--bar-surface: var(--color-hero-dot);
		box-shadow: none;
	}

	/* The mark never mutates, but on the picture its cells are cut from the
	   ground instead of from paper — pale plates over a dark image read as a
	   white blob, which is the one thing the cube must not become. */
	.site-header.is-over-hero:not(.is-sticky):not(:has(.search-toggle:checked)) .brand-cube-cell {
		fill: color-mix(in srgb, var(--accent) 46%, var(--color-primary));
	}
	.site-header.is-over-hero:not(.is-sticky):not(:has(.search-toggle:checked)) .brand-cube-cell--b {
		fill: color-mix(in srgb, var(--accent) 26%, var(--color-primary));
	}

	/* The edge rides the hero's clock. `--c1…--c6` are the CMS colours Base
	   passes down; with no rotation (a vertical page) the edge simply keeps
	   that page's accent, and `--c1` is the resting colour if the animation
	   never runs — reduced motion, or a browser that skips it. */
	.site-header.is-over-hero.is-rotating {
		border-bottom-color: var(--c1, var(--accent));
	}
	.site-header.is-over-hero.is-rotating:not(.is-sticky):not(:has(.search-toggle:checked)) {
		animation: site-header-edge var(--hero-cycle) steps(1, end) infinite;
		animation-delay: -0.5s;
	}

	@keyframes site-header-edge {
		0% { border-bottom-color: var(--c1); }
		16.6667% { border-bottom-color: var(--c2); }
		33.3333% { border-bottom-color: var(--c3); }
		50% { border-bottom-color: var(--c4); }
		66.6667% { border-bottom-color: var(--c5); }
		83.3333% { border-bottom-color: var(--c6); }
		100% { border-bottom-color: var(--c1); }
	}

	/* Manual mode: the visitor picked a plate, so the clock is over. The edge
	   stops with it and takes that plate's colour, which the hero's script
	   parks on the root — the header is outside the component and a custom
	   property is the only thing that crosses. The `:not()`s are repeated so
	   this outweighs the animation rule above rather than tying with it. */
	body:has(.s-hero.is-manual) .site-header.is-over-hero.is-rotating:not(.is-sticky):not(:has(.search-toggle:checked)) {
		animation: none;
		border-bottom-color: var(--hero-now, var(--c1));
	}

	/* …and it stops when the hero stops, or the two drift apart within one
	   cycle and the bar starts announcing a slide that is not on screen. */
	body:has(.s-hero__pause:checked) .site-header,
	body:has(.s-hero:focus-within) .site-header {
		animation-play-state: paused;
	}

	@media (prefers-reduced-motion: reduce) {
		/* the selector is repeated in full on purpose: a bare `.site-header`
		   here loses to the six-class rule above and the edge keeps cycling */
		.site-header.is-over-hero.is-rotating:not(.is-sticky):not(:has(.search-toggle:checked)) {
			animation: none;
		}
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 14px;
	}

	.header-brand {
		display: flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
	}

	.menu-toggle {
		background: none;
		border: none;
		cursor: pointer;
		padding: 4px;
		line-height: 0;
		border-radius: var(--radius);
	}

	.menu-toggle:hover .brand-cube,
	.menu-toggle:focus-visible .brand-cube {
		transform: translateY(-1px);
	}

	.brand-cube {
		display: block;
		transition: transform 0.15s;
	}

	.brand-cube-cell {
		fill: var(--cell-a);
	}

	.brand-cube-cell--b {
		fill: var(--cell-b);
	}

	.brand-cube-edge {
		fill: none;
		stroke: var(--bar-ink);
		stroke-width: 13;
		stroke-linejoin: round;
		stroke-linecap: round;
	}

	.brand-prompt {
		display: flex;
		align-items: baseline;
		min-width: 0;
		text-decoration: none;
		color: var(--bar-ink);
		font-family: var(--font-mono), monospace;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.brand-path {
		font-weight: 500;
		/* Ink text over an accent-tinted "terminal selection" — the color
		   signal stays while text contrast stays AA (colored glyphs on white
		   failed color-contrast: #F38020 is 2.4:1). */
		color: var(--bar-ink);
		background: color-mix(in srgb, var(--accent, transparent) 22%, transparent);
		border-radius: var(--radius);
		padding-inline: 2px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		/* token-guard: off — truncation, not a measure: the breadcrumb path
		   ellipsises against the viewport so the brand never wraps. */
		max-width: 34vw;
		/* token-guard: on */
	}

	.brand-word {
		white-space: nowrap;
	}

	/* ═══════════════════════════════════════════
	   SEARCH — the prompt, made real (#338)
	   The checkbox drives it in pure CSS so the field survives with no
	   JavaScript; :has() is used instead of a sibling combinator because the
	   breadcrumb it hides sits BEFORE the toggle in the DOM.
	   ═══════════════════════════════════════════ */
	.search-toggle {
		/* Invisible but REAL: Tab reaches it, Space toggles it, and a screen
		   reader announces it from its aria-label. Sized 1px rather than
		   display:none, which would remove it from the tab order — the bug
		   this replaces. It sits under the icon, which is its label. */
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	/* A second line, the way a terminal actually behaves: the line you were
	   looking at stays untouched and a new prompt opens underneath. Nothing
	   competes for the breadcrumb's width, and the magnifier never moves —
	   it sits with the other controls. */
	/* A LIGHT console — the inverse of `.s-boot`. Plenty of terminals ship a
	   light theme; a dark strip under a white bar was a hole in the page.
	   What makes it read as a console is not the ground but the details:
	   the prompt glyph, the fixed syntax in one weight and the argument in
	   another, the selection tint, and the key hint at the end of the line. */
	.search-form {
		display: none;
		background: var(--color-surface);
		border-top: 1px solid var(--color-border);
		font-family: var(--font-family-mono);
		font-size: 13px;
	}
	.search-line {
		display: flex;
		align-items: baseline;
		gap: 0;
		padding-block: 11px;
		min-width: 0;
	}
	/* the prompt glyph carries the section colour at full strength — on a
	   light ground the raw accent needs no lightening, and on ink pages it
	   lands as the neutral grey-black the rest of the bar already uses */
	.search-ps {
		color: var(--accent);
		font-weight: 700;
		margin-right: 9px;
	}

	.site-header:has(.search-toggle:checked) .search-form { display: block; }

	/* the fixed half of the command reads as syntax, not as content */
	.search-chrome {
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	/* THE SLOT — the same "terminal selection" the breadcrumb path already
	   wears (`.brand-path`), so the two lines speak one language: tinted
	   ground for what is selected, ink for the glyphs so contrast holds. */
	.search-slot {
		min-width: 0;
		background: color-mix(in srgb, var(--accent) 22%, transparent);
		border-radius: var(--radius);
		padding-inline: 3px;
		/* the rule is always 2px so focus recolours it without moving the
		   baseline — a border, not a shadow: this underlines a blank to fill,
		   and the token file owns shadows for depth, which this is not */
		border-bottom: 2px solid color-mix(in srgb, var(--accent) 40%, transparent);
	}
	.search-slot:focus-within { border-bottom-color: var(--accent); }

	/* the key hint sits where a shell would print its own status */
	.search-hint {
		margin-left: auto;
		padding-left: 16px;
		color: var(--color-text-muted);
		white-space: nowrap;
	}
	.search-hint kbd {
		font: inherit;
		border: 1px solid var(--color-border);
		border-bottom-width: 2px;
		border-radius: var(--radius);
		padding: 0 4px;
		background: var(--color-secondary);
	}

	.search-input {
		max-width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		font: inherit;
		color: var(--color-text);
		/* grows with what you type; `size` on the element is the fallback */
		field-sizing: content;
	}
	.search-input:focus { outline: none; }
	.search-input::placeholder { color: var(--color-text-muted); opacity: 1; }
	/* Safari paints its own clear button in the middle of the command */
	.search-input::-webkit-search-decoration,
	.search-input::-webkit-search-cancel-button { appearance: none; }

	.search-btn {
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border-radius: var(--radius);
		color: var(--bar-ink-soft);
		cursor: pointer;
		flex: none;
	}
	.search-btn:hover { color: var(--bar-ink); background: var(--bar-surface); }
	.site-header:has(.search-toggle:checked) .search-btn {
		color: var(--color-text);
		background: var(--color-surface);
	}
	.site-header:has(.search-toggle:focus-visible) .search-btn {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* ≤767: the bar already splits cube, wordmark, path and locale. §14 forbids
	   internal horizontal scroll outright, so the control does not compete for
	   that width — on phones it belongs in the menu, which is full-screen. */
	@media (max-width: 767px) {
		/* scoped to the header: the menu's copy must survive this rule */
		.site-header .search-form,
		.search-btn { display: none; }
		.site-header:has(.search-toggle:checked) .search-form { display: none; }
	}

	/* The menu copy IS the phone's search: always open inside the dialog, and
	   absent from tablet up, where the header line already exists.

	   The rule has not changed since #338 — the console is the INVERSE of the
	   ground it sits on — but the ground has, twice. #417 moved the panel to
	   ink and this copy went near-black with it; #431 moved it back to paper,
	   so every one of those overrides is gone and the menu's console is the
	   header's console again, differing only in that it is a boxed block
	   instead of a strip under the bar. Nothing to re-derive: the base rules
	   above already say all of it. */
	.search-form--menu {
		display: block;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		margin-bottom: var(--space-3);
	}
	/* The line WRAPS here, and only here. At 390 the command plus the key hint
	   measured 452px inside a 390px viewport on every page whose search word
	   is long — "carrito-abandonado", "trazabilidad", "alucinación" — and the
	   hint sat 65px off the right edge. It has been doing that since #338. It
	   was invisible for the same reason it was unmeasurable: an off-screen
	   pixel photographs black, the panel was black, and §4 read the hint as
	   comfortably light-on-dark. On paper it reported "3.9:1 against #000000",
	   which is the gate describing a layout bug in the only vocabulary it has.
	   A terminal wraps a long line rather than scrolling it sideways, and §14
	   forbids the sideways option outright. */
	.search-form--menu .search-line {
		padding: 12px 14px;
		flex-wrap: wrap;
		row-gap: 8px;
	}
	/* Placeholder and typed value share one ink. #338's whole point is that
	   the line is a REAL command whose argument happens to be pre-filled —
	   "what you type IS the argument, so the line stays a valid `find` while
	   you type it" — and a dimmed argument is a command that has not been
	   written yet. It also could not survive the measurement: the one reduced
	   step is 4.9:1 on the console's own ground and 3.1:1 once the selection
	   tint is under it, which is what §4 caught. #417 made the same call on
	   the ink panel for the same reason — a placeholder is the label of an
	   empty field, not decoration. */
	.search-form--menu .search-input::placeholder { color: var(--color-text); }
	/* The hint carries `<kbd>enter</kbd>`, and a keycap has a border: on the
	   ink panel #417 built, that border never met the muted ink. #432 made
	   the panel paper and put them in one box — `--color-text-muted` is
	   annotated "5.4:1 on paper", which it is, but against the keycap's
	   `--color-border` it measures 4.28:1 and 1.4.3 asks 4.5. One step
	   firmer clears it by 9.2:1, wide enough that a font-metric difference
	   cannot flip it back the way it flipped this one (#436). */
	.search-form--menu .search-hint { color: var(--color-ink-soft); }
	@media (min-width: 768px) {
		.search-form--menu { display: none; }
	}

	/* ≤480: everything cedes to the breadcrumb — flush cube, tight gaps,
	   smaller type; the path takes ALL remaining width and only then
	   ellipsizes (the two extreme slugs are the only ones that still do). */
	@media (max-width: 480px) {
		.site-header .header-inner { padding-inline: 12px; }
		.header-brand { flex: 1; gap: 8px; }
		.brand-cube { width: 26px; height: 30px; }
		.brand-prompt { font-size: 0.8rem; flex: 1; }
		.brand-path {
			max-width: none;
			flex: 0 1 auto;
			min-width: 0;
			font-size: 0.75rem;
		}
	}

	.brand-cursor {
		width: 0.5em;
		height: 1.05em;
		background: var(--bar-ink);
		margin-left: 2px;
		align-self: center;
		animation: brand-blink 1.2s steps(1) infinite;
	}

	@keyframes brand-blink {
		50% { opacity: 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-cursor { animation: none; }
		.brand-cube { transition: none; }
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	@media (min-width: 768px) {
		.brand-cube { width: 34px; height: 39px; }
		.brand-prompt { font-size: 1.05rem; }
		/* token-guard: off — same truncation, wider on small screens */
		.brand-path { max-width: 44vw; }
		/* token-guard: on */
	}
</style>
