---
/**
 * SiteHeader — the wayfinding compass (#213, design #211 v7).
 *
 * Three pieces in one bar: the 2×2 logo cube (always ink — the mark never
 * mutates) as the menu trigger, the wordmark extended into a terminal-prompt
 * breadcrumb (~Server Startup/<path>▮ with the path in the section color),
 * and a 3px bottom edge carrying the same color. The accent comes from the
 * CMS service entry (via Base) — ink on site pages.
 */
import LanguageSwitcher from "./LanguageSwitcher.astro";
import SearchPrompt from "./SearchPrompt.astro";

interface Props {
	promptPath: string; // current pathname ("" on home)
	accent: string; // section color from CMS, ink for site pages
	altPath: string | null; // alternate-locale path resolved by Base (#291)
}
const { promptPath, accent, altPath } = Astro.props;

// The brand prompt is the way back home — locale-aware, or EN visitors
// land on the Spanish home (#273)
const homeHref = (Astro.currentLocale || "es") === "en" ? "/en" : "/";

const t = Astro.locals.t;

// V2 (#216): the mark never changes shape and the strokes stay ink — but on
// section pages the 2×2 cells take the section color (the same language as
// the menu's mini-dice). Ink pages keep the plate greys. Base sends the
// literal ink fallback for non-section pages.
const isSection = accent !== "#1E1E1E";
const cellA = isSection ? `color-mix(in srgb, ${accent} 30%, white)` : "#CED4DA";
const cellB = isSection ? `color-mix(in srgb, ${accent} 18%, white)` : "#E3E7EB";
---

<header class="site-header" id="site-header" style={`--accent:${accent}`}>
	<div class="container header-inner">
		<div class="header-brand">
			<button
				type="button"
				class="menu-toggle"
				id="menu-trigger"
				aria-expanded="false"
				aria-controls="menu-dialog"
				aria-label={t("open_menu")}
			>
				<svg class="brand-cube" width="30" height="34" viewBox="0 0 200 228" aria-hidden="true">
					<polygon points="100,14 186,64 100,114 14,64" fill={cellA}></polygon>
					<polygon points="14,64 100,114 100,214 14,164" fill={cellA}></polygon>
					<polygon points="100,114 186,64 186,164 100,214" fill={cellB}></polygon>
					<path class="brand-cube-edge" d="M100,14 186,64 186,164 100,214 14,164 14,64 Z"></path>
					<path class="brand-cube-edge" d="M14,64 100,114 186,64 M100,114 100,214"></path>
					<path class="brand-cube-edge" d="M57,39 143,89 M143,39 57,89"></path>
					<path class="brand-cube-edge" d="M57,89 57,189 M14,114 100,164 M143,89 143,189 M100,164 186,114"></path>
				</svg>
			</button>
			<a href={homeHref} class="brand-prompt">
				<span class="brand-word">~Server Startup</span><span class="brand-path">{promptPath}</span><span class="brand-cursor" aria-hidden="true"></span>
			</a>
		</div>
		<div class="header-actions">
			{/* The toggle lives with the other controls so it never moves — and
			    it is a REAL control: focusable and announced. It shipped with
			    `tabindex="-1" aria-hidden="true"` in #338, which made the
			    search reachable by mouse or by the `/` shortcut and by nothing
			    else. Tabbing the deployed page found three stops in the header
			    and none of them was this one (WCAG 2.1.1). */}
			<input
				type="checkbox"
				id="search-toggle"
				class="search-toggle"
				aria-label={t("search_open")}
			/>
			<label for="search-toggle" class="search-btn" aria-hidden="true">
				<svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<circle cx="8.5" cy="8.5" r="5.5"></circle>
					<path d="M13 13l4.5 4.5"></path>
				</svg>
			</label>
			<LanguageSwitcher altPath={altPath} />
		</div>
	</div>
	<SearchPrompt pathname={Astro.url.pathname} accent={accent} />
</header>

<style is:global>
	/* ═══════════════════════════════════════════
	   HEADER — the compass (mobile-first)
	   ═══════════════════════════════════════════ */
	.site-header {
		/* clip, not hidden: transient pre-font overflow must neither widen
		   the document (sticky mobile viewport expansion) nor create a
		   scroll container */
		overflow-x: clip;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background-color: var(--color-secondary);
		border-bottom: 3px solid var(--accent, var(--color-primary));
		transition: box-shadow 0.3s;
	}

	.site-header.is-sticky {
		box-shadow: var(--shadow-card);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 14px;
	}

	.header-brand {
		display: flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
	}

	.menu-toggle {
		background: none;
		border: none;
		cursor: pointer;
		padding: 4px;
		line-height: 0;
		border-radius: var(--radius);
	}

	.menu-toggle:hover .brand-cube,
	.menu-toggle:focus-visible .brand-cube {
		transform: translateY(-1px);
	}

	.brand-cube {
		display: block;
		transition: transform 0.15s;
	}

	.brand-cube-edge {
		fill: none;
		stroke: var(--color-primary);
		stroke-width: 13;
		stroke-linejoin: round;
		stroke-linecap: round;
	}

	.brand-prompt {
		display: flex;
		align-items: baseline;
		min-width: 0;
		text-decoration: none;
		color: var(--color-primary);
		font-family: var(--font-mono), monospace;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.brand-path {
		font-weight: 500;
		/* Ink text over an accent-tinted "terminal selection" — the color
		   signal stays while text contrast stays AA (colored glyphs on white
		   failed color-contrast: #F38020 is 2.4:1). */
		color: var(--color-primary);
		background: color-mix(in srgb, var(--accent, transparent) 22%, transparent);
		border-radius: var(--radius);
		padding-inline: 2px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		/* token-guard: off — truncation, not a measure: the breadcrumb path
		   ellipsises against the viewport so the brand never wraps. */
		max-width: 34vw;
		/* token-guard: on */
	}

	.brand-word {
		white-space: nowrap;
	}

	/* ═══════════════════════════════════════════
	   SEARCH — the prompt, made real (#338)
	   The checkbox drives it in pure CSS so the field survives with no
	   JavaScript; :has() is used instead of a sibling combinator because the
	   breadcrumb it hides sits BEFORE the toggle in the DOM.
	   ═══════════════════════════════════════════ */
	.search-toggle {
		/* Invisible but REAL: Tab reaches it, Space toggles it, and a screen
		   reader announces it from its aria-label. Sized 1px rather than
		   display:none, which would remove it from the tab order — the bug
		   this replaces. It sits under the icon, which is its label. */
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	/* A second line, the way a terminal actually behaves: the line you were
	   looking at stays untouched and a new prompt opens underneath. Nothing
	   competes for the breadcrumb's width, and the magnifier never moves —
	   it sits with the other controls. */
	/* A LIGHT console — the inverse of `.s-boot`. Plenty of terminals ship a
	   light theme; a dark strip under a white bar was a hole in the page.
	   What makes it read as a console is not the ground but the details:
	   the prompt glyph, the fixed syntax in one weight and the argument in
	   another, the selection tint, and the key hint at the end of the line. */
	.search-form {
		display: none;
		background: var(--color-surface);
		border-top: 1px solid var(--color-border);
		font-family: var(--font-family-mono);
		font-size: 13px;
	}
	.search-line {
		display: flex;
		align-items: baseline;
		gap: 0;
		padding-block: 11px;
		min-width: 0;
	}
	/* the prompt glyph carries the section colour at full strength — on a
	   light ground the raw accent needs no lightening, and on ink pages it
	   lands as the neutral grey-black the rest of the bar already uses */
	.search-ps {
		color: var(--accent);
		font-weight: 700;
		margin-right: 9px;
	}

	.site-header:has(.search-toggle:checked) .search-form { display: block; }

	/* the fixed half of the command reads as syntax, not as content */
	.search-chrome {
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	/* THE SLOT — the same "terminal selection" the breadcrumb path already
	   wears (`.brand-path`), so the two lines speak one language: tinted
	   ground for what is selected, ink for the glyphs so contrast holds. */
	.search-slot {
		min-width: 0;
		background: color-mix(in srgb, var(--accent) 22%, transparent);
		border-radius: var(--radius);
		padding-inline: 3px;
		/* the rule is always 2px so focus recolours it without moving the
		   baseline — a border, not a shadow: this underlines a blank to fill,
		   and the token file owns shadows for depth, which this is not */
		border-bottom: 2px solid color-mix(in srgb, var(--accent) 40%, transparent);
	}
	.search-slot:focus-within { border-bottom-color: var(--accent); }

	/* the key hint sits where a shell would print its own status */
	.search-hint {
		margin-left: auto;
		padding-left: 16px;
		color: var(--color-text-muted);
		white-space: nowrap;
	}
	.search-hint kbd {
		font: inherit;
		border: 1px solid var(--color-border);
		border-bottom-width: 2px;
		border-radius: var(--radius);
		padding: 0 4px;
		background: var(--color-secondary);
	}

	.search-input {
		max-width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		font: inherit;
		color: var(--color-text);
		/* grows with what you type; `size` on the element is the fallback */
		field-sizing: content;
	}
	.search-input:focus { outline: none; }
	.search-input::placeholder { color: var(--color-text-muted); opacity: 1; }
	/* Safari paints its own clear button in the middle of the command */
	.search-input::-webkit-search-decoration,
	.search-input::-webkit-search-cancel-button { appearance: none; }

	.search-btn {
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border-radius: var(--radius);
		color: var(--color-text-muted);
		cursor: pointer;
		flex: none;
	}
	.search-btn:hover { color: var(--color-text); background: var(--color-surface); }
	.site-header:has(.search-toggle:checked) .search-btn {
		color: var(--color-text);
		background: var(--color-surface);
	}
	.site-header:has(.search-toggle:focus-visible) .search-btn {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* ≤767: the bar already splits cube, wordmark, path and locale. §14 forbids
	   internal horizontal scroll outright, so the control does not compete for
	   that width — on phones it belongs in the menu, which is full-screen. */
	@media (max-width: 767px) {
		/* scoped to the header: the menu's copy must survive this rule */
		.site-header .search-form,
		.search-btn { display: none; }
		.site-header:has(.search-toggle:checked) .search-form { display: none; }
	}

	/* The menu copy IS the phone's search: always open inside the dialog, and
	   absent from tablet up, where the header line already exists. */
	.search-form--menu {
		display: block;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		margin-bottom: var(--space-3);
	}
	.search-form--menu .search-line { padding: 12px 14px; }
	@media (min-width: 768px) {
		.search-form--menu { display: none; }
	}

	/* ≤480: everything cedes to the breadcrumb — flush cube, tight gaps,
	   smaller type; the path takes ALL remaining width and only then
	   ellipsizes (the two extreme slugs are the only ones that still do). */
	@media (max-width: 480px) {
		.site-header .header-inner { padding-inline: 12px; }
		.header-brand { flex: 1; gap: 8px; }
		.brand-cube { width: 26px; height: 30px; }
		.brand-prompt { font-size: 0.8rem; flex: 1; }
		.brand-path {
			max-width: none;
			flex: 0 1 auto;
			min-width: 0;
			font-size: 0.75rem;
		}
	}

	.brand-cursor {
		width: 0.5em;
		height: 1.05em;
		background: var(--color-primary);
		margin-left: 2px;
		align-self: center;
		animation: brand-blink 1.2s steps(1) infinite;
	}

	@keyframes brand-blink {
		50% { opacity: 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-cursor { animation: none; }
		.brand-cube { transition: none; }
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	@media (min-width: 768px) {
		.brand-cube { width: 34px; height: 39px; }
		.brand-prompt { font-size: 1.05rem; }
		/* token-guard: off — same truncation, wider on small screens */
		.brand-path { max-width: 44vw; }
		/* token-guard: on */
	}
</style>
