{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "www-serverstartup-io",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "www-serverstartup-io",
			// Run `wrangler d1 create my-emdash-site` and paste the real ID here for deploy
			"database_id": "1b3b50f2-0269-4fe2-8f80-1b55b08bdfa1",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "www-serverstartup-io","preview_bucket_name": "www-serverstartup-io",
		},
	],
	// KV Namespace for Astro sessions
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "3d255fdb73a9480b9010cdb5eb7ff4cb",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
}
